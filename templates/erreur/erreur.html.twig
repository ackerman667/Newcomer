{% extends 'layout_ag.html.twig' %}
{% block title %}<title>Mentions légales - {{app.user.appli}}</title>{% endblock %}
{% block body %}<body  class="page not-home">{% endblock %}
{% block header %}
    <div class="title_app" id="title">
        <h1 class="title">{{ app.user.appli }}</h1>
        <h2 class="desc">{{ app.user.libappli }}</h2>
    </div>
    <div class="title_image">
        <span>Rectorat</span>
    </div>
    <h3 class="page-title">Erreur</h3>  
{% endblock %}
{% block main %}
    <main class="row justify-content-md-left">
        <div class="col-md-12 col-sm-12 col-lg-9">
            <article>
                <h2>Erreur d'accès à l'application :</h2>
                <p><strong>Module : </strong>{{module}}</p>
                <h2>Message d'erreur:</h2>
                <h3>{{message}}</h3>
            </article>
        </div>
    </main>
{% endblock %}