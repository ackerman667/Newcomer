{% extends 'layout_ag.html.twig' %}
{% block title %}<title>Profil - {{monApplication.Appli}}</title>{% endblock %}
{% block head_gene %}
   <style>
    .main-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 40px;
    }
    .photo {
        position: relative;
        margin-bottom: 20px;
        width: 200px; 
        height: 200px; 
        border-radius: 50%;
        overflow: hidden; 
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); 
    }
    .photo img {
        width: 100%;
        height: 100%;
        object-fit: cover; 
    }
    .user-info {
        text-align: center;
    }
    .user-info h2 {
        font-size: 1.5rem;
        color: #333;
    }
    .user-info p {
        margin: 5px 0;
        font-size: 1rem;
    }
    .user-info p strong {
        font-weight: bold;
    }
    .user-info .email, .user-info .date-naissance {
        font-style: italic;
        color: #555;
    }
</style>

{% endblock %}
{% block body %}<body  class="page not-home">{% endblock %}
{% block header %}
    <div class="title_app" id="title">
        <h1 class="title">{{monApplication.Appli}}</h1>
        <h2 class="desc">{{monApplication.LibAppli}}</h2>
    </div>
    <div class="title_image">
        <span>Rectorat</span>
    </div>
    <h3 class="page-title">Profil utilisateur</h3>  
    {{ include("./profil/pagemenu.html.twig") }}
{% endblock %}
{% block main %}
{% for message in app.flashes('error') %}
    <div class="alert alert-warning">
        {{ message }}
    </div>
{% endfor %}

{% if app.session.get('ldap_authenticated') %}
<main class="main-container">
    <figure class="photo">
        <img src="{{ asset('css/images/avatar/avatar.png','interfaceappli') }}" alt="Avatar de l'utilisateur">
    </figure>

    <div class="user-info">
        <h2> {{user.codecivilite }} {{ user.nom }} {{ user.prenom }}</h2>
          {% if user.codecivilite== "M." %}
                 <p>né le : <span class="date-naissance">{{ user.dateNaissance }}</span></p>
            {% else %}
              <p>née le : <span class="date-naissance">{{ user.dateNaissance }}</span></p>
            {% endif %}
       

       
        <p><strong>Courriel:</strong> <span class="email">{{ user.email }}</span></p>
        
    </div>
</main>
{% else %}
<main class="main-container">
    <figure class="photo">
        <img src="{{ asset('css/images/avatar/avatar.png','interfaceappli') }}" alt="Avatar de l'utilisateur">
    </figure>

    <div class="user-info">
        <h2>Utilisateur anonyme</h2>
    </div>
</main>
{% endif %}

{% endblock %}
