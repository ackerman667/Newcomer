{% extends 'layout_ag.html.twig' %}
{% block title %}<title>Profil - {{monApplication.Appli}}</title>{% endblock %}
{% block body %}<body  class="page not-home">{% endblock %}
{% block header %}
    <div class="title_app" id="title">
        <h1 class="title">{{monApplication.Appli}}</h1>
        <h2 class="desc">{{monApplication.LibAppli}}</h2>
    </div>
    <div class="title_image">
        <span>Rectorat</span>
    </div>
    <h3 class="page-title">Profil utilisateur</h3>  
    {{ include("./profil/pagemenu.html.twig") }}
{% endblock %}
{% block main %}
{% for message in app.flashes('error') %}
    <div class="alert alert-warning">
        {{ message }}
    </div>
{% endfor %}

<main class="row">
    <h4>Vos informations</h4>
    <div class="user-info">
        <p><strong>Email :</strong> {{ user.email }}</p>
        <p><strong>Date de naissance :</strong> {{ user.dateNaissance }}</p>
    </div>

    <address>
        <span id="vcard" class="vcard">
            <figure class="photo">
                <img src="{{ asset('css/images/avatar/avatar.png','interfaceappli') }}" alt="Avatar de l'utilisateur">
            </figure>
            {% if user %}
                <h2 class="fn">{{ 'Utilisateur'|trans }} : {{ user.nom }} {{ user.prenom }}</h2>
            {% endif %}
            {% if not user %}
                <h2 class="fn">{{ 'Utilisateur anonyme'}} </h2>
            {% endif %}
        </span>
    </address>
</main>
{% endblock %}
