{% extends 'layout_ag.html.twig' %}
{% block title %}<title>Profil - {{monApplication.Appli}}</title>{% endblock %}
{% block body %}<body  class="page not-home">{% endblock %}
{% block header %}
    <div class="title_app" id="title">
        <h1 class="title">{{monApplication.Appli}}</h1>
        <h2 class="desc">{{monApplication.LibAppli}}</h2>
    </div>
    <div class="title_image">
        <span>Rectorat</span>
    </div>
    <h3 class="page-title">Profil utilisateur</h3>  
    {{ include("./profil/pagemenu.html.twig") }}
{% endblock %}
{% block main %}
<main class="row">
    <h4>Vos rôles pour l'application : {{monApplication.Appli}}</h4>
    <address>
        <span id="vcard" class="vcard">
            <figure class="photo"><img src="{{ asset('css/images/avatar/avatar.png','interfaceappli') }}"></figure>
            <ol>
           {% if app.user is not null %}
    {{ app.user.roles|join(', ') }}
{% else %}
  <h5> Rôle inconnu </h5>
{% endif %}
              
            </ol>
        </span>
    </address>
</main>
{% endblock %}