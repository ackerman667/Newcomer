{% extends 'layout_ag.html.twig' %}

{% block title %}<title>Vérification de l'email</title>{% endblock %}

{% block body %}
<body class="page not-home">
{% endblock %}

{% block header %}
    <h1 class="page-title">Vérification de l'email</h1>
{% endblock %}

{% block main %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <!-- Message d'information -->
            <div class="info-box">
                <p>Cette page est destinée aux utilisateurs qui n'ont pas d'adresse email académique. Veuillez entrer votre adresse email personnelle pour procéder.</p>
            </div>
            
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger">
                    {{ message }}
                </div>
            {% endfor %}
            
            {{ form_start(form) }}
            <div class="form-group">
                {{ form_label(form.email) }}
                {{ form_widget(form.email, { 'attr': {'class': 'form-control input-lg'} }) }}
            </div>
            <div class="form-group text-center">
                <button type="submit" class="btn btn-primary">Vérifier</button>
            </div>
            {{ form_end(form) }}

            <div class="text-center mt-4">
                {# <p>Vous n'avez pas de compte ? <a href="{{ path('user_creation') }}" class="create-account-link">Cliquez ici pour créer un compte</a></p> #}
            </div>
        </div>
    </div>
</div>

<style>
    .info-box {
        background-color: #e7f3fe;
        border: 1px solid #b3d4fc;
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 5px;
        text-align: center;
        font-size: 16px;
        color: #31708f;
    }
    .form-group {
        margin-bottom: 15px;
        text-align: left; 
        max-width: 400px;
        margin-left: auto;
        margin-right: auto;
    }
    .form-group label {
        font-weight: bold;
    }
    .form-group .input-lg {
        font-size: 16px;
        padding: 10px;
        max-width: 100%; 
    }
    .btn-primary {
        margin-top: 20px;
        font-size: 16px;
        padding: 10px 20px;
    }
    .page-title {
        text-align: center;
        font-style: italic;
        color: #04A0DB;
        margin-bottom: 20px;
        font-size: 24px; 
    }
    .alert {
        margin-top: 20px;
    }
    .create-account-link {
        color: #007bff;
        text-decoration: none;
    }
    .create-account-link:hover {
        text-decoration: underline;
    }
    .mt-4 {
        margin-top: 1.5rem !important;
    }
</style>

{% endblock %}
