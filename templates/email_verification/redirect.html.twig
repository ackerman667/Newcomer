{% extends 'layout_ag.html.twig' %}

{% block title %}
    <title>Création de votre compte - Vérification de l'e-mail</title>
{% endblock %}

{% block main %}
<div class="container mt-5">
    <div class="text-center">
        <h2 class="page-title">Vérification de l'e-mail</h2>
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">Nous allons commencer la création de votre compte !</h4>
            <p class="mb-2">
                Merci de patienter, vous serez redirigé dans quelques secondes...
            </p>
          
        </div>
 
    </div>
</div>

<script>
    setTimeout(function() {
        window.location.href = "{{ redirect_url }}";
    }, 7000); 
</script>
<style>
    .page-title {
        text-align: center;
        font-style: italic;
        color: #04A0DB;
        margin-bottom: 20px;
    }
    .alert {
        margin: 20px auto;
        max-width: 600px;
    }
    .img-fluid {
        margin-top: 20px;
    }
</style>
{% endblock %}
