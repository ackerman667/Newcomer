{# templates/demande/consult.html.twig #}

{% extends 'layout_ag.html.twig' %}

{% block title %}<title>Consultation de la demande - {{ monApplication.Appli }}</title>{% endblock %}

{% block head_gene %}
    <script type="text/javascript" src="{{ asset('js/documentation.js','interfaceappli') }}" defer></script>
    <style>
        .form-section {
            border: 1px solid #000;
            padding: 15px;
            margin-bottom: 20px;
        }
        .form-section-title {
            font-weight: bold;
            margin-bottom: 10px;
            text-align: center;
        }
        .form-group-inline {
            display: flex;
            align-items: center;
        }
        .form-group-inline > div {
            margin-right: 15px;
        }
    </style>
{% endblock %}

{% block body %}<body class="page not-home">{% endblock %}

{% block header %}
    <div class="title_app" id="title">
        <h1 class="title">{{ monApplication.Appli }}</h1>
        <h2 class="desc">{{ monApplication.LibAppli }}</h2>
    </div>
    <div class="title_image">
        <span>Rectorat</span>
    </div>
    <h3 class="page-title">Consultation de la demande</h3>  
{% endblock %}

{% block main %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="form-section">
                <div class="form-section-title">Remplacement de</div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Nom :</label>
                            <p>{{ demande.utilisateur.nom }}</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Prénom :</label>
                            <p>{{ demande.utilisateur.prenom }}</p>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label>Numéro de téléphone avant de quitter le service :</label>
                    <p>{{ demande.telephoneAvantService }}</p>
                </div>
                <div class="form-group">
                    <label>Parti du Rectorat :</label>
                    <p>{{ demande.partiRectorat ? 'Oui' : 'Non' }}</p>
                </div>
                {% if not demande.partiRectorat %}
                <div class="form-group">
                    <label>Si non, dans quel service est la nouvelle affectation :</label>
                    <p>{{ demande.nouvelleAffectationService }}</p>
                </div>
                {% endif %}
            </div>

            <div class="form-section">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Nom :</label>
                            <p>{{ demande.utilisateur.nom }}</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Prénom :</label>
                            <p>{{ demande.utilisateur.prenom }}</p>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Service :</label>
                            <p>{{ demande.selectedService }}</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Fonction :</label>
                            <p>{{ demande.fonction }}</p>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label>Date de naissance :</label>
                    <p>{{ demande.dateDeNaissance|date('d/m/Y') }}</p>
                </div>
                <div class="form-group">
                    <label>Missions :</label>
                    <p>{{ demande.missions }}</p>
                </div>
                <div class="form-group">
                    <label>Statut :</label>
                    <p>{{ demande.statut }}</p>
                </div>
                {% if demande.statut != 'Titulaire' %}
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Date de début de contrat :</label>
                            <p>{{ demande.dateDebutContrat|date('d/m/Y') }}</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Date de fin de contrat :</label>
                            <p>{{ demande.dateFinContrat|date('d/m/Y') }}</p>
                        </div>
                    </div>
                </div>
                {% endif %}
                <div class="form-group">
                    <label>N° de téléphone du bureau :</label>
                    <p>{{ demande.telephoneBureau }}</p>
                </div>
            </div>

            <div class="form-section">
                <div class="form-group">
                    <label>Besoin d’une adresse de messagerie académique :</label>
                    <p>{{ demande.messagerieAcademique ? 'Oui' : 'Non' }}</p>
                </div>
                <div class="form-group">
                    <label>Besoin d’accès à des dossiers partagés :</label>
                    <p>{{ demande.accesDossiers ? 'Oui' : 'Non' }}</p>
                </div>
                {% if demande.accesDossiers %}
                <div class="form-group">
                    <label>Si oui, merci de les lister :</label>
                    <p>{{ demande.listeDossiers }}</p>
                </div>
                {% endif %}
                <div class="form-group">
                    <label>Besoin d’accéder à une imprimante autre que « PrintOnDemand » :</label>
                    <p>{{ demande.imprimantePrintOnDemand ? 'Oui' : 'Non' }}</p>
                </div>
                {% if demande.imprimantePrintOnDemand %}
                <div class="form-group">
                    <label>Si oui, merci de lister le ou les numéros des bureaux où se trouvent les imprimantes :</label>
                    <p>{{ demande.listeImprimantes }}</p>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
