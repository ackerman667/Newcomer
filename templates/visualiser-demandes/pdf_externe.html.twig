{% block title %}

{% endblock %}
{% block head_gene %}
<script type="text/javascript" src="{{ asset('js/inactivity.js') }}" defer></script>
    <style>
          .details-section {
            border: 1px solid #000;
            padding: 15px;
            margin-bottom: 20px;
              page-break-inside: avoid;  
    break-inside: avoid;
        }
              .details-group.commentaire span {
    word-wrap: break-word;      /* Coupe les mots longs */
    overflow-wrap: break-word;  /* Alternative moderne */
    white-space: normal;        /* Permet le retour à la ligne naturel */
    display: inline;            /* Reste en ligne sans sauter de ligne complète */
}
        .details-section-title {
            font-weight: bold;
            margin-bottom: 10px;
            text-align: center;
        }
        .details-group {
            margin-bottom: 15px;
        }
        .details-group label {
            font-weight: bold;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }
        .header .left {
            text-align: left;
        }
        .header .right {
            text-align: right;
            text-align: center;
        }
        .header img {
            height: 80px; 
        }
        .header h1 {
            font-size: 20px;
        }
        .header .subtitle {
            font-size: 18px;
            font-weight: normal;
        }
        h2 {
            font-size: 20px; 
        }

    </style>
{% endblock %}
{% block body %}
<body class="page not-home">
    <div class="header">
        <div class="left">
      <img src="{{ imageSrc }}" alt="Logo">


        </div>
        <div class="right">
            <h1>Demande d'accès à un poste de travail informatique</h1>
            <p class="subtitle">Région Académique Guadeloupe</p>
        </div>
    </div>
{% endblock %}
{% block header %}
    
   
{% endblock %}
{% block main %}
    <div class="container">
        <div class="row justify-content-center">
            <h2 class="text-center mb-5">Récapitulatif de votre demande</h2>
            <div class="col-md-10">
                <div class="details-section">
                    <div class="details-section-title">Détails de la Demande</div>
                    <div class="details-group">
                        <label>Chef de service :</label>
                        <span>{{ valideur }}</span>
                    </div>
                    <div class="details-group">
                        <label>Titre :</label>
                        <span>{{ demande.titre }}</span>
                    </div>
                    <div class="details-group">
                        <label>Date de Soumission :</label>
                        <span>{{ demande.date ? demande.date|date('d/m/Y') : '' }}</span>
                    </div>
                    <div class="details-group">
                        <label>Heure de Soumission :</label>
                        <span>{{ demande.heureSoumission ? demande.heureSoumission|date('H:i') : '' }}</span>
                    </div>
                    {% if demande.statuts == 'Suivi dans LEKA' %}
                    <div class="details-group" style="color: green;">
                        <label>Date de Validation de la demande :</label>
                        <span>{{ demande.dateValidation ? demande.dateValidation|date('d/m/Y') : '' }}</span>
                    </div>
                {% endif %}
                   
                    <div class="details-group">
                        <label>Nom Prédécesseur :</label>
                        <span>{{ demande.nomRemplacant }}</span>
                    </div>
                    <div class="details-group">
                        <label>Prénom Prédécesseur :</label>
                        <span>{{ demande.prenomRemplacant }}</span>
                    </div>
                    <div class="details-group">
                        <label>Téléphone Prédécesseur :</label>
                        <span>{{ demande.telephoneRemplacant }}</span>
                    </div>
                    <div class="details-group">
                        <label>Affectation Prédécesseur :</label>
                        <span>{{ demande.affectationRemplacant }}</span>
                    </div>
                </div>

                <div class="details-section">
                    <div class="details-section-title">Détails du demandeur</div>
                    
                
                        <!-- Affichage des informations pour soi-même -->
                        <div class="details-group">
                            <label>Nom :</label>
                            <span>{{ user.nom }}</span>
                        </div>
                        <div class="details-group">
                            <label>Prénom :</label>
                            <span>{{ user.prenom }}</span>
                        </div>
                         <div class="details-group">
                            <label>Date de Naissance :</label>
                            <span>{{ user.dateDeNaissance ? user.dateDeNaissance|date('d/m/Y') : '' }}</span>
                        </div>
                        <div class="details-group">
                            <label>Email :</label>
                            <span>{{ user.email }}</span>
                        </div>
                        <div class="details-group">
                            <label>Fonction :</label>
                            <span>{{ user.fonction }}</span>
                        </div>
                        <div class="details-group">
                            <label>Statut :</label>
                            <span>{{ user.statutPersonne }}</span>
                        </div>
                       
                        <div class="details-group" {% if user.statutPersonne == 'Titulaire' %} style="display:none" {% endif %}>
                            <label>Date de Début de Contrat :</label>
                            <span>{{ user.dateDebut ? user.dateDebut|date('d/m/Y') : '' }}</span>
                        </div>
                        <div class="details-group" {% if user.statutPersonne == 'Titulaire' %} style="display:none" {% endif %}>
                            <label>Date de Fin de Contrat :</label>
                            <span>{{ user.dateFin ? user.dateFin|date('d/m/Y') : '' }}</span>
                        </div>
               
                </div>

                <div class="details-section">
                    <div class="details-section-title">Ressources Associées</div>
                    <div class="details-group">
                        <label>{{ ressources.nom }} :</label>
                        <span>{{ ressources.contenu }}</span>
                    </div>
                    <div class="details-group">
                        <label>Service :</label>
                        <span>{{ demande.service }}</span>
                    </div>
                     <div class="details-group">
                        <label> Avez vous besoin d'un numéro de Téléphone Bureau ? :</label>
                         <span>
        {% if 'Num Tel' in ressources.contenu %}
            Oui
        {% else %}
            Non
        {% endif %}

    </span>
                    </div>
                    <div class="details-group commentaire">
    <label> Commentaire du valideur:</label>
    <span>{% if demande.commentaire %}
        {{ demande.commentaire }} 
        {% else %}
        Pas de commentaire 
        {% endif %}
    </span>
</div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
