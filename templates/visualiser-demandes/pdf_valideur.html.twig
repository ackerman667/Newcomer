{% block title %}

{% endblock %}
{% block head_gene %}
    <style>
        .details-section {
            border: 1px solid #000;
            padding: 15px;
            margin-bottom: 20px;
              page-break-inside: avoid;  
    break-inside: avoid;
        }
        .details-section-title {
            font-weight: bold;
            margin-bottom: 10px;
            text-align: center;
        }
        .details-group {
            margin-bottom: 15px;
        }
        .details-group label {
            font-weight: bold;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }
        .header .left {
            text-align: left;
        }
        .header .right {
            text-align: right;
            text-align: center;
        }
        .header img {
            height: 80px; 
        }
        .header h1 {
            font-size: 20px; 
        }
        .header .subtitle {
            font-size: 18px;
            font-weight: normal;
        }
        h2 {
            font-size: 20px; 
        }
        .details-group.commentaire span {
    word-wrap: break-word;      
    overflow-wrap: break-word;  
    white-space: normal;        
    display: inline;            
}

    </style>
{% endblock %}
{% block body %}<body class="page not-home">{% endblock %}
{% block header %}
    <div class="header">
        <div class="left">
            <img src="{{ imageSrc }}" alt="Logo">
        </div>
        <div class="right">
            <h1>Demande d'accès à un poste de travail informatique</h1>
            <p class="subtitle">Région Académique Guadeloupe</p>
        </div>
    </div>
{% endblock %}
{% block main %}
    <div class="container">
        <div class="row justify-content-center">
            <h2 class="text-center mb-5">Récapitulatif de votre demande</h2>
            
            <div class="col-md-10">
            {% if demande.isAutrePersonne %}
    <p style="font-size: 18px; line-height: 1.6; margin-bottom: 30px;">
    La demande a été effectuée par : 
    <span style="font-weight: bold;  ">
        {{ demande.IDutilisateur.nom }} {{ demande.IDutilisateur.prenom }}
    </span> 
    <span style=" color: #333;">
        pour
    </span> 
    <span style="font-weight: bold; color: #e60000;">
        {{ user.nom }} {{ user.prenom }}
    </span>
</p>

{% endif %}
                <div class="details-section">
                
                    <div class="details-section-title">Détails de la Demande</div>
                      <div class="details-group">
                       {% if demande.statuts ==  'Suivi dans LEKA' %}
                        <label>Validé par :</label>
                        <span>{{ valideurInfos.givenname }} {{ valideurInfos.sn }}</span>
                        {% else %}
                        <label>chef de service  : </label>
                        <span>{{ valideur }}</span>
                        {% endif %}



                    </div>
                    
                    <div class="details-group">
                        <label>Titre :</label>
                        <span>{{ demande.titre }}</span>
                    </div>
                    <div class="details-group">
                        <label>Date de Soumission :</label>
                        <span>{{ demande.date ? demande.date|date('d/m/Y') : '' }}</span>
                    </div>
                    <div class="details-group">
                        <label>Heure de Soumission :</label>
                        <span>{{ demande.heureSoumission ? demande.heureSoumission|date('H:i') : '' }}</span>
                    </div>
                   {% if demande.statuts == 'Suivi dans LEKA' %}
                    <div class="details-group" style="color: green;">
                        <label>Date de Validation de la demande :</label>
                        <span>{{ demande.dateValidation ? demande.dateValidation|date('d/m/Y') : '' }}</span>
                    </div>
                {% endif %}

                 
                    <div class="details-group">
                        <label>Nom Prédécesseur :</label>
                        <span>{{ demande.nomRemplacant }}</span>
                    </div>
                    <div class="details-group">
                        <label>Prénom Prédécesseur :</label>
                        <span>{{ demande.prenomRemplacant }}</span>
                    </div>
                    <div class="details-group">
                        <label>Téléphone Prédécesseur :</label>
                        <span>{{ demande.telephoneRemplacant }}</span>
                    </div>
                    <div class="details-group">
                        <label>Affectation Prédécesseur :</label>
                        <span>{{ demande.affectationRemplacant }}</span>
                    </div>
                </div>

                <div class="details-section">
                    <div class="details-section-title">Détails du demandeur</div>
                    
                    {% if demande.isAutrePersonne %}
                        <!-- Affichage des informations pour une autre personne -->
                        <div class="details-group">
                            <label>Nom :</label>
                            <span>{{ user.nom }}</span>
                        </div>
                        <div class="details-group">
                            <label>Prénom :</label>
                            <span>{{ user.prenom }}</span>
                        </div>
                         <div class="details-group">
                            <label>Date de Naissance :</label>
                            <span>{{ user.date_de_naissance ? user.date_de_naissance|date('d/m/Y') : '' }}</span>
                        </div>
                        <div class="details-group">
                            <label>Email :</label>
                            <span>{{ user.email }}</span>
                        </div>
                        <div class="details-group">
                            <label>Fonction :</label>
                            <span>{{ user.fonction }}</span>
                        </div>
                        <div class="details-group">
                            <label>Statut :</label>
                            <span>{{ user.statut }}</span>
                             <div class="details-group" {% if user.statut == 'Titulaire' %} style="display:none" {% endif %}>
                            <label>Date de Début de Contrat :</label>
                            <span>{{ user.date_debut ? user.date_debut|date('d/m/Y') : '' }}</span>
                        </div>
                        <div class="details-group" {% if user.statut == 'Titulaire' %} style="display:none" {% endif %}>
                            <label>Date de Fin de Contrat :</label>
                            <span>{{ user.date_fin ? user.date_fin|date('d/m/Y') : '' }}</span>
                        </div>
                        </div>
                       
                    {% else %}
                        <!-- Affichage des informations pour soi-même -->
                        <div class="details-group">
                            <label>Nom :</label>
                            <span>{{ user.nom }}</span>
                        </div>
                        <div class="details-group">
                            <label>Prénom :</label>
                            <span>{{ user.prenom }}</span>
                        </div>
                         <div class="details-group">
                            <label>Date de Naissance :</label>
                            <span>{{ user.date_de_naissance ? user.date_de_naissance|date('d/m/Y') : '' }}</span>
                        </div>
                        <div class="details-group">
                            <label>Email :</label>
                            <span>{{ user.email }}</span>
                        </div>
                        <div class="details-group">
                            <label>Fonction :</label>
                            <span>{{ user.fonction }}</span>
                        </div>
                        <div class="details-group">
                            <label>Statut :</label>
                            <span>{{ user.statut }}</span>
                        </div>
                        
                        <div class="details-group" {% if user.statut == 'Titulaire' %} style="display:none" {% endif %}>
                            <label>Date de Début de Contrat :</label>
                            <span>{{ user.date_debut ? user.date_debut|date('d/m/Y') : '' }}</span>
                        </div>
                        <div class="details-group" {% if user.statut == 'Titulaire' %} style="display:none" {% endif %}>
                            <label>Date de Fin de Contrat :</label>
                            <span>{{ user.date_fin ? user.date_fin|date('d/m/Y') : '' }}</span>
                        </div>
                    {% endif %}
                </div>

                <div class="details-section">
                    <div class="details-section-title">Ressources Associées</div>
                    <div class="details-group">
                        <label>{{ ressources.nom }} :</label>
                        <span>{{ ressources.contenu }}</span>
                    </div>
                    <div class="details-group">
                        <label>Service :</label>
                        <span>{{ demande.service }}</span>
                    </div>
                    <div class="details-group">
                        <label> Avez vous besoin d'un numéro de Téléphone Bureau ? :</label>
                         <span>
        {% if 'Num Tel' in ressources.contenu %}
            Oui
        {% else %}
            Non
        {% endif %}

    </span>
                    </div>
                    <div class="details-group commentaire">
    <label> Commentaire du valideur:</label>
    <span>{% if demande.commentaire %}
        {{ demande.commentaire }} 
        {% else %}
        Pas de commentaire 
        {% endif %}
    </span>
</div>

                   
                    
                </div>
                 
            
                
            </div>
           
        </div>
    </div>
{% endblock %}
