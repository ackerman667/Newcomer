{% extends 'layout_ag.html.twig' %}

{% block title %}<title>Confirmation de création de compte - {{ monApplication.Appli }}</title>{% endblock %}

{% block main %}
<div class="container mt-4">
    <div class="alert alert-success" role="alert">
        {{ app.flashes('success')|join('<br>') }}
    </div>
    <p>Votre compte a bien été créé. Veuillez l'activer par mail en cliquant sur le lien d'activation que nous vous avons envoyé.</p>
</div>
{% endblock %}
