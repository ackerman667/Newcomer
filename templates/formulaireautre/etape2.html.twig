{# templates/formulaire/etape2.html.twig #}
{% extends 'layout_ag.html.twig' %}

{% block title %}<title>Étape 2 - {{ monApplication.Appli }}</title>{% endblock %}
{% block head_gene %}
    <style>
        .form-section {
            border: 1px solid #000;
            padding: 15px;
            margin-bottom: 20px;
        }
        .form-section-title {
            font-weight: bold;
            margin-bottom: 10px;
            text-align: center;
        }
         .page-counter {
            font-weight: bold;
            text-align: right;
            
        }
        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            font-weight: bold;
        }
        .form-group-inline {
            display: flex;
            align-items: center;
        }
        .form-group-inline > div {
            margin-right: 15px;
        }
        .btn-group {

        }
    </style>
{% endblock %}
{% block body %}{% endblock %}
{% block header %}
  
{% endblock %}
{% block main %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            {{ form_start(form) }}

         
            <div class="form-section">
                <div class="form-section-title">Informations Personnelles</div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.nom) }}
                            {{ form_widget(form.nom, { 'attr': {'class': 'form-control'} }) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.prenom) }}
                            {{ form_widget(form.prenom, { 'attr': {'class': 'form-control'} }) }}
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email, { 'attr': {'class': 'form-control'} }) }}
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.selectedService) }}
                            {{ form_widget(form.selectedService, { 'attr': {'class': 'form-control'} }) }}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            {{ form_label(form.fonction) }}
                            {{ form_widget(form.fonction, { 'attr': {'class': 'form-control'} }) }}
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    {{ form_label(form.date_de_naissance) }}
                    {{ form_widget(form.date_de_naissance, { 'attr': {'class': 'form-control'} }) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.missions) }}
                    {{ form_widget(form.missions, { 'attr': {'class': 'form-control'} }) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.statut) }}
                    {{ form_widget(form.statut, { 'attr': {'class': 'form-control statut-select'} }) }}
                </div>
                <div class="row contract-dates" style="display: none;">
                    <div class="col-md-6">
                        {{ form_label(form.date_debut_contrat) }}
                        {{ form_widget(form.date_debut_contrat, { 'attr': {'class': 'form-control'} }) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.date_fin_contrat) }}
                        {{ form_widget(form.date_fin_contrat, { 'attr': {'class': 'form-control'} }) }}
                    </div>
                </div>
            </div>

            <div class="btn-group">
                <a href="{{ path('formulaireldap-etape1', { 'token': token }) }}" class="btn btn-secondary">Précédent</a>

                <button class="btn btn-primary">Suivant</button>
            </div>
                <div class="page-counter">
                    {{ current_step }} / {{ total_steps }}
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const statutField = document.querySelector('.statut-select');
    const contractDates = document.querySelectorAll('.contract-dates');
    const dateDebutContrat = document.querySelector('#{{ form.date_debut_contrat.vars.id }}');
    const dateFinContrat = document.querySelector('#{{ form.date_fin_contrat.vars.id }}');
    const form = document.querySelector('form[name="{{ form.vars.name }}"]');

    function toggleContractDates() {
        const selectedValue = statutField.value;

        if (selectedValue !== 'Titulaire' && selectedValue !== '') {

            contractDates.forEach(field => {
                field.style.display = 'block';
            });
        } else {

            contractDates.forEach(field => {
                field.style.display = 'none';
            });

            dateDebutContrat.value = ''; 
            dateFinContrat.value = ''; 
            dateFinContrat.setCustomValidity(''); 
        }
    }

    toggleContractDates();

    statutField.addEventListener('change', toggleContractDates);

    function validateDateRange() {
        const selectedValue = statutField.value; 
        if (selectedValue === 'Titulaire' || selectedValue === '') {

            dateFinContrat.setCustomValidity('');
            return; 
        }

        const dateDebut = new Date(dateDebutContrat.value); 
        const dateFin = new Date(dateFinContrat.value); 

        if (dateDebutContrat.value && dateFinContrat.value && dateFin < dateDebut) {

            dateFinContrat.setCustomValidity('La date de fin de contrat ne peut pas être antérieure à la date de début de contrat.');
        } else {
            dateFinContrat.setCustomValidity(''); 
        }
    }

    dateDebutContrat.addEventListener('input', validateDateRange);
    dateFinContrat.addEventListener('input', validateDateRange);

    form.addEventListener('submit', function (event) {
        validateDateRange(); 
        if (!form.checkValidity()) {
            event.preventDefault(); 
            alert('Veuillez corriger les erreurs dans le formulaire.');
        }
    });
});
</script>

{% endblock %}
