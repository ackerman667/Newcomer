    <!-- FORCAGE THEME PAR DEFAUT/CLEAR MODE
    <!-- My SCSS -->
    {# <link id="my-css" href="{{ asset('css/' ~ app.user.theme ~ '.css','interfaceappli') }}" rel="stylesheet"> #}
    <link id="my-css" href="{{ asset('css/theme2.css','interfaceappli') }}" rel="stylesheet">
    <link id="my-mode" href="{{ asset('css/clear_ie.css','interfaceappli') }}" rel="stylesheet">
    <link rel="shortcut icon" href="favicon.ico" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />  
