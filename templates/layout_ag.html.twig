    <style>
      .tooltipster-base .tooltipster-content{
          /*padding:0;*/
          text-align:center;
          color:#007bff;
      }
      #valid-choice_content{
          color:#007bff;
      }
    </style>
    <script>
      $("document").ready(function (){
        var my_css = localStorage.getItem('#theme');
        if( $('.title').length &&  $('.desc').length)         
        {
          var title_length = $('.title').text().length;
          var desc_length = $('.desc').text().length;
          var tot_length = title_length+desc_length;
        
          var title_size = $('.title').css('font-size').slice(0, -2);
          var desc_size = $('.desc').css('font-size').slice(0, -2);
    
        
          if (tot_length > 50){
            var tot_title = (title_size -8)+"px";
            $('.title').css('font-size',tot_title);
            $('.title').css('margin-bottom','0px');
            var tot_desc = (desc_size -3)+"px";
            $('.desc').css('font-size',tot_desc);
          }
        }        
        if ( my_css == "accessibilite")
        {
          $("head #my-css").attr("href","{{ asset('css/accessibilite.css','interfaceappli') }}");
        }
        else
        {
          
          $("head #my-css").attr("href","{{ asset('css/theme2.css','interfaceappli') }}");
        }
        //récupère le storage du mode de background
        var my_mode = localStorage.getItem('#mode');
        if ( my_mode == "dark")
        {
          $("head #my-mode").attr("href","{{ asset('css/dark_ie.css','interfaceappli') }}");
        }
        else
        {
          $("head #my-mode").attr("href","{{ asset('css/clear_ie.css','interfaceappli') }}");
        }

        // animation accueil
        $(function() {
          $('#title').addClass('move_right');
          $('#logo').addClass('move_left');
        });


        $('#info').tooltipster({
          side: 'left',
          theme: 'tooltipster-shadow'
        });
        $('.tooltipster.btn').tooltipster({
          trigger:'click',
          side: 'right',
          contentAsHTML: true,
          interactive: true,
          theme: 'tooltipster-shadow'
        });

        $(".simple .my_menu_button").click(function (){
        // animation menu gene
          $(".menu_gene").toggleClass("open simple");
          $(".logo_central").toggleClass("pad1");
          $("body").toggleClass("pad");
        });
        
        // vide le champ recherche
        $(".search").focusin(function(){
          $(this).val('');
        });



        //Bouton de validation de la sortie à la déconnexion
        
        $(".valid-choice").each(function( index ) { //boucle sur les éléments ayant comme class valid-choice
        //console.log($(this).data( "options" ).question);
        
        // Ajout d'une étiquette au click avec deux boutons inclus
        $(this).append("<div class='tooltip_templates valid-choice_content'><span id='"+$(this).attr('id')+"_content'><form><label style='clear: both; display: block; text-align: center;'></label><input class='choix1 btn btn-primary' type='button' name='valid-choice' value=''><input class='choix2 btn btn-outline-primary' type='button' name='valid-choice' value=''></form></span></div>");

        // Définition de la tooltip à ouvrir
        let myElementId="#"+$(this).attr('id');
        $(myElementId).attr("data-tooltip-content",myElementId+"_content");
        // récupère l'attribut data-options et renseigne les valeurs dans le tooltip 
        $(myElementId+"_content label").html($(this).data( "options" ).question);
        $(myElementId+"_content .choix1").attr("value",$(this).data( "options" ).choix1);
        $(myElementId+"_content .choix2").attr("value",$(this).data( "options" ).choix2);

        // Click sur choix1
        $(myElementId+"_content .choix1").on("click", function () {

          // Vérifie dans data-options si action1 a été renségné
          let monjson = $(myElementId).data( "options" ).action1;
          if(typeof monjson !== 'undefined'){
            window.location.replace($(myElementId).data( "options" ).action1);
          }
          else{ // sinon récupère le href du lien et redirige
            window.location.replace($(myElementId).attr('href'));
          }

        });

        //Click sur choix2
        $(myElementId+"_content .choix2").on("click", function () {
          // Vérifie dans data-options si action1 a été renségné
          let monjson = $(myElementId).data( "options" ).action2;
          if(typeof monjson !== 'undefined'){
            //Au click ferme la fenêtre
            if ($(myElementId).data( "options" ).action2 == "close"){ // vérifie si action2 est à close
              $('.valid-choice').tooltipster('close');
            }
            else {
              // sinon on redirige vers une autre adresse renseignée dans action2
              window.location.replace($(myElementId).data( "options" ).action2);
            }
          }
          else{
            $('.valid-choice').tooltipster('close');
          }
        });
        });
        $('.valid-choice').tooltipster({
          trigger:'click',
          side: 'right',
          contentAsHTML: true,
          interactive: true,
          theme: 'tooltipster-shadow'
        });       

        {% block script %}{% endblock %}
      });
    </script>
    
    {% block head_gene %}{% endblock %}
	</head>
