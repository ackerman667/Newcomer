<option value="{{ service.id_service }}">
    {% for i in 0..level %}
        &nbsp;&nbsp;&nbsp;
    {% endfor %}
    {{ service.service }}
</option>
{% if service.children is not empty %}
    {% for child in service.children %}
        {% include 'formulaire/service_arbre.html.twig' with { service: child, level: level + 1 } %}
    {% endfor %}
{% endif %}
