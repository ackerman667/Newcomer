{% extends 'layout_ag.html.twig' %}

{% block title %}<title>Étape 1 - {{ monApplication.Appli }}</title>{% endblock %}
{% block head_gene %}
    <style>
        .form-section {
            border: 1px solid #000;
            padding: 15px;
            margin-bottom: 20px;
        }
        .form-section-title {
            font-weight: bold;
            margin-bottom: 10px;
            text-align: center;
        }
        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            font-weight: bold;
        }
        .form-group-inline {
            display: flex;
            align-items: center;
        }
        .form-group-inline > div {
            margin-right: 15px;
        }
        .btn-primary {
            margin-top: 20px;
        }
        .title-page {
            text-align: center;
            font-style: italic;
            color: #04A0DB;
        }
        .page-counter {
            font-weight: bold;
        }
        .inline-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .bold-label {
            font-weight: bold;
        }
    </style>
{% endblock %}
{% block body %}<body class="page not-home">{% endblock %}
{% block header %}
    <div class="title_app" id="title">
        <h1 class="title">{{ monApplication.Appli }}</h1>
        <h2 class="desc">{{ monApplication.LibAppli }}</h2>
    </div>
    <div class="title_image">
        <span>Rectorat</span>
    </div>
    <div class="title-page" id="title2">
        <h2 class="title-page">Demande d'un accès à un poste de travail informatique</h2>
    </div>
{% endblock %}
{% block main %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-10">
            {{ form_start(form) }}

            <!-- Question Remplacez-vous quelqu'un -->
            <div class="form-group">
                {{ form_label(form.replace_someone, null, {'label_attr': {'class': 'bold-label'}}) }}
                <div class="form-group-inline">
                    {{ form_widget(form.replace_someone) }}
                </div>
            </div>

            <!-- Bloc Remplacement De -->
            <div id="remplacement-section" style="display: none;">
                <div class="form-section">
                    <div class="form-section-title">Remplacement de</div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                {{ form_label(form.remplacement_nom) }}
                                {{ form_widget(form.remplacement_nom, { 'attr': {'class': 'form-control remplacement-field'} }) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                {{ form_label(form.remplacement_prenom) }}
                                {{ form_widget(form.remplacement_prenom, { 'attr': {'class': 'form-control remplacement-field'} }) }}
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        {{ form_label(form.telephone_avant_service) }}
                        {{ form_widget(form.telephone_avant_service, { 'attr': {'class': 'form-control remplacement-field'} }) }}
                    </div>
                    <div class="form-group">
                        {{ form_label(form.parti_rectorat) }}
                        <div class="form-group-inline">
                            {{ form_widget(form.parti_rectorat) }}
                        </div>
                    </div>
                    <div class="form-group" id="form_nouvelle_affectation_service" style="display: none;">
                        {{ form_label(form.nouvelle_affectation_service) }}
                        {{ form_widget(form.nouvelle_affectation_service, { 'attr': {'class': 'form-control remplacement-field'} }) }}
                    </div>
                </div>
            </div>

            <div class="inline-container">
                <button id="next-button" class="btn btn-primary">Suivant</button>
                <div class="page-counter">
                     {{ current_step }} / {{ total_steps }}
                </div>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const replaceSomeoneYes = document.querySelector('[name="demande_etape1_form[replace_someone]"][value="1"]');
    const replaceSomeoneNo = document.querySelector('[name="demande_etape1_form[replace_someone]"][value="0"]');
    const remplacementSection = document.getElementById('remplacement-section');
    const nextButton = document.getElementById('next-button');
    const remplacementFields = document.querySelectorAll('.remplacement-field');

    function toggleRemplacementSection() {
        if (replaceSomeoneYes.checked) {
            remplacementSection.style.display = 'block';
            remplacementFields.forEach(field => field.required = true);
        } else {
            remplacementSection.style.display = 'none';
            remplacementFields.forEach(field => field.required = false);
        }
    }

    function validateRemplacementFields() {
        let allFilled = true;
        if (replaceSomeoneYes.checked) {
            remplacementFields.forEach(field => {
                if (!field.value) {
                    allFilled = false;
                }
            });
        }
        return allFilled;
    }

    replaceSomeoneYes.addEventListener('change', toggleRemplacementSection);
    replaceSomeoneNo.addEventListener('change', toggleRemplacementSection);

    nextButton.addEventListener('click', function(event) {
        if (replaceSomeoneYes.checked && !validateRemplacementFields()) {
            event.preventDefault();
            alert('Veuillez remplir tous les champs de remplacement.');
        }
    });

    // Initial check on page load
    toggleRemplacementSection();

    const partiRectoratFields = document.querySelectorAll('[name="demande_etape1_form[parti_rectorat]"]');
    const nouvelleAffectationField = document.getElementById('form_nouvelle_affectation_service');

    function toggleField(radioGroup, textField) {
        radioGroup.forEach(radio => {
            radio.addEventListener('change', function () {
                textField.style.display = (radio.value !== '1' && radio.checked) ? 'block' : 'none';
            });

            if (radio.checked) {
                textField.style.display = (radio.value !== '1') ? 'block' : 'none';
            }
        });
    }

    toggleField(partiRectoratFields, nouvelleAffectationField);
});
</script>
{% endblock %}
