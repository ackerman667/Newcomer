{% extends 'layout_ag.html.twig' %}

{% block title %}
<title>Accès à vos demandes - {{ monApplication.Appli }}</title>
{% endblock %}

{% block head_gene %}
<style>
    .message-container {
        border: 1px solid #000;
        padding: 20px;
        margin-top: 20px;
        text-align: center;
    }
    .message-container h1 {
        font-size: 24px;
        margin-bottom: 20px;
    }
    .message-container p {
        font-size: 18px;
        margin-bottom: 20px;
    }
</style>
{% endblock %}

{% block main %}
<div class="message-container">
    <h1>Accès à vos demandes</h1>
    <p>Un e-mail avec un lien pour accéder à vos demandes a été envoyé. Veuillez consulter votre boîte mail pour voir l'état de vos demandes.</p>
</div>
{% endblock %}

