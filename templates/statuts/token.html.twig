{% extends 'layout_ag.html.twig' %}
{% block title %}<title>Historique de vos demandes - {{ monApplication.Appli }}</title>{% endblock %}
{% block head_gene %}
    <style>
        .table-container {
            margin: 20px auto;
            width: 90%;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            text-align: center;
            padding: 12px;
            border-bottom: 1px solid #ddd;
        }
        th {
            background-color: #f8f8f8;
        }
        .details-section {
            border: 1px solid #000;
            padding: 15px;
            margin-bottom: 20px;
        }
        .details-section-title {
            font-weight: bold;
            margin-bottom: 10px;
            text-align: center;
        }
        .details-group {
            margin-bottom: 15px;
        }
        .details-group label {
            font-weight: bold;
        }
        .details-group span {
            display: block;
            margin-top: 5px;
        }
        .btn-primary {
            margin-top: 20px;
        }
        .page-title {
            text-align: center;
            font-style: italic;
            color: #04A0DB;
            margin-bottom: 30px;
        }
        .alert {
            margin-top: 20px;
            text-align: center;
        }
        .status-brouillons {
            background-color: #FFC107;
            color: white;
            padding: 5px 10px;
            border-radius: 20px;
            display: inline-block;
            min-width: 100px; 
            margin: 5px 0;
        }
        .status-leka {
            background-color: #28A745;
            color: white;
            padding: 5px 10px;
            border-radius: 20px;
            display: inline-block;
            min-width: 100px; 
            margin: 5px 0;
        }
        .status-en-attente {
            background-color: #D3D3D3;
            color: white;
            padding: 5px 10px;
            border-radius: 20px;
            display: inline-block;
            min-width: 100px; 
            margin: 5px 0;
        }
        .icon-edit {
            color: #1E90FF !important;
        }
        .icon-search {
            color: #1E90FF !important;
        }
        .icon-trash {
            color: #1E90FF !important;
        }
        .icon-thumbs-up {
            color: #1E90FF !important;
        }
        .icon-pdf {
            color: #1E90FF !important;
        }
        .status-refuse {
            background-color: #FF0000;
            color: white;
            padding: 5px 10px;
            border-radius: 20px;
            display: inline-block;
            min-width: 100px;
            margin: 5px 0;
        }
        .new-request-btn {
            display: block;
            margin: 20px auto;
            text-align: center;
        }
    </style>
{% endblock %}
{% block body %}<body class="page not-home">{% endblock %}
{% block header %}
    <h3 class="page-title">Historique de vos demandes</h3>
{% endblock %}
{% block main %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-10">
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">
                        {{ message }}
                    </div>
                {% endfor %}

                {# Bouton "Nouvelle Demande" placé en dehors de la boucle #}
                <div class="new-request-btn">
                    <a href="{{ path('nouvelle_demande', { token: user.token }) }}" class="btn btn-primary">Nouvelle Demande</a>
                </div>

                <table style="width:100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 1px solid #ddd;">
                            <th style="text-align: center; padding: 8px;">Titre</th>
                            <th style="text-align: center; padding: 8px;">Date de soumission</th>
                            <th style="text-align: center; padding: 8px;">Heure de soumission</th>
                            <th style="text-align: center; padding: 8px;">Statut</th>
                            <th style="text-align: center; padding: 8px;">Commentaire</th>
                            <th style="text-align: center; padding: 8px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if demandes is empty %}
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 8px;">Vous n'avez aucune demande pour l'instant</td>
                            </tr>
                        {% else %}
                            {% for demande in demandes %}
                                <tr style="border-bottom: 1px solid #ddd;">
                                    <td style="text-align: center; padding: 8px;">{{ demande.titre }}</td>
                                    <td style="text-align: center; padding: 8px;">{{ demande.date ? demande.date|date('d/m/Y') : '' }}</td>
                                    <td style="text-align: center; padding: 8px;">{{ demande.heureSoumission ? demande.heureSoumission|date('H:i') : '' }}</td>
                                    <td class="status-cell" style="text-align: center; padding: 8px;">
                                        <span class="{% if demande.statuts == 'Brouillons' %}status-brouillons{% elseif demande.statuts == 'Suivi dans LEKA' %}status-leka{% elseif demande.statuts == 'En attente' %}status-en-attente{% elseif demande.statuts == 'Refusée' %}status-refuse{% endif %}">{{ demande.statuts }}</span>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                        <span>{{ demande.commentaire ? demande.commentaire : 'Aucun commentaire' }}</span>
                                    <td style="text-align: center; padding: 8px;">
                                    {% if demande.statuts == 'Brouillons' %}
                                        <a href="{{ path('modifier_demandes', {id: demande.id}) }}">
                                            <i class="fas fa-edit icon-edit"></i>
                                        </a>
                                        <a href="{{ path('demande_consult', {token: demande.token}) }}">
                                            <i class="fas fa-search icon-search"></i>
                                        </a>
                                        <a href="{{ path('formulairetest_supprimer', {id: demande.id}) }}" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette demande ?');">
                                            <i class="fas fa-trash-alt icon-trash"></i>
                                        </a>
                                        <a href="{{ path('valider_demandes', {id: demande.id}) }}">
                                            <i class="fas fa-thumbs-up icon-thumbs-up"></i>
                                        </a>
                                        <a href="{{ path('demande_pdf', {token: demande.token}) }}">
                                            <i class="fas fa-file-pdf icon-pdf"></i>
                                        </a>
                                    {% else %}
                                        <a href="{{ path('demande_consult', {token: demande.token}) }}">
                                            <i class="fas fa-search icon-search"></i>
                                        </a>
                                        <a href="{{ path('demande_pdf', {token: demande.token}) }}">
                                            <i class="fas fa-file-pdf icon-pdf"></i>
                                        </a>
                                    {% endif %}
                                </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function () {
        setTimeout(function () {
            let alerts = document.querySelectorAll('.alert');
            alerts.forEach(function (alert) {
                alert.classList.remove('show');
                alert.classList.add('fade');
            });
        }, 5000); 
    });
    </script>
{% endblock %}
