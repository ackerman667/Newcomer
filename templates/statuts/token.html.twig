{% extends 'layout_ag.html.twig' %}
{% block title %}<title>Historique de vos demandes - {{ monApplication.Appli }}</title>{% endblock %}
{% block head_gene %}
    <style>
        .details-section {
            border: 1px solid #000;
            padding: 15px;
            margin-bottom: 20px;
        }
        .details-section-title {
            font-weight: bold;
            margin-bottom: 10px;
            text-align: center;
        }
        .details-group {
            margin-bottom: 15px;
        }
        .details-group label {
            font-weight: bold;
        }
        .details-group span {
            display: block;
            margin-top: 5px;
        }
        .btn-primary {
            margin-top: 20px;
        }
        .page-title {
            text-align: center;
            font-style: italic;
            color: #04A0DB;
            margin-bottom: 30px;
        }
        .alert {
            margin-top: 20px;
            text-align: center;
        }
        .status-en-attente {
            background-color: #FFC107;
            color: white;
            padding: 5px 10px;
            border-radius: 20px;
            display: inline-block;
            min-width: 100px; 
            margin: 5px 0;
        }
        .status-valide {
            background-color: #28A745;
            color: white;
            padding: 5px 10px;
            border-radius: 20px;
            display: inline-block;
            min-width: 100px; 
            margin: 5px 0;
        }
        .btn-danger, .btn-pdf {
            margin: 5px;
        }
    </style>
{% endblock %}
{% block body %}<body class="page not-home">{% endblock %}
{% block header %}
    <h3 class="page-title">Historique de vos demandes</h3>
{% endblock %}
{% block main %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-10">
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">
                        {{ message }}
                    </div>
                {% endfor %}
                <table style="width:100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 1px solid #ddd;">
                            <th style="text-align: center; padding: 8px;">Titre</th>
                            <th style="text-align: center; padding: 8px;">Date de soumission</th>
                            <th style="text-align: center; padding: 8px;">Heure de soumission</th>
                            <th style="text-align: center; padding: 8px;">Statut</th>
                            <th style="text-align: center; padding: 8px;">Modifier la demande</th>
                            <th style="text-align: center; padding: 8px;">Visualiser</th>
                            <th style="text-align: center; padding: 8px;">Commentaire</th>
                            <th style="text-align: center; padding: 8px;">Supprimer</th>
                             <th style="text-align: center; padding: 8px;">PDF</th>
                            <th style="text-align: center; padding: 8px;">Valider</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if demandes is empty %}
                            <tr>
                                <td colspan="9" style="text-align: center; padding: 8px;">Vous n'avez aucune demande pour l'instant</td>
                            </tr>
                        {% else %}
                            {% for demande in demandes %}
                                <tr style="border-bottom: 1px solid #ddd;">
                                    <td style="text-align: center; padding: 8px;">{{ demande.titre }}</td>
                                    <td style="text-align: center; padding: 8px;">{{ demande.date ? demande.date|date('d/m/Y') : '' }}</td>
                                    <td style="text-align: center; padding: 8px;">{{ demande.heureSoumission ? demande.heureSoumission|date('H:i') : '' }}</td>
                                    <td class="status-cell" style="text-align: center; padding: 8px;">
                                        <span class="{% if demande.statuts == 'En attente' %}status-en-attente{% elseif demande.statuts == 'Validé' %}status-valide{% endif %}">{{ demande.statuts }}</span>
                                    </td>
                                    
                                    {% if demande.statuts == 'En attente' %}
                                        <td style="text-align: center; padding: 8px;">
                                        <a href="{{ path('modifier_demandes', {id: demande.id}) }}">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </td>
                                       <td style="text-align: center; padding: 8px;">
                                            <a href="{{ path('demande_consult', {token: demande.token}) }}">
                                                <i class="fas fa-search"></i>
                                            </a>
                                        </td>

                                        <td style="text-align: center; padding: 8px;">
                                            <span>{{ demande.commentaire ? demande.commentaire : 'Aucun commentaire' }}</span>
                                        </td>
                                       <td style="text-align: center; padding: 8px;">
                                            <a href="{{ path('formulairetest_supprimer', {id: demande.id}) }}" class="btn btn-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette demande ?');">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </td>

                                    {% else %}
                                        <td style="text-align: center; padding: 8px;">
                                            <span style="color: gray;" title="La demande ne peut pas être modifiée car elle a déjà été traitée">
                                                <i class="fas fa-edit"></i>
                                            </span>
                                        </td>

                                        <td style="text-align: center; padding: 8px;">
                                            <a href="{{ path('demande_consult', {token: demande.token}) }}">
                                                <i class="fas fa-search"></i>
                                            </a>
                                        </td>

                                        <td style="text-align: center; padding: 8px;">
                                            <span>{{ demande.commentaire ? demande.commentaire : 'Aucun commentaire' }}</span>
                                        </td>
                                        <td style="text-align: center; padding: 8px;">
                                            <span style="color: gray;" title="La demande ne peut pas être supprimée car elle a déjà été traitée">
                                                <i class="fas fa-trash-alt"></i>
                                            </span>
                                        </td>

                                    {% endif %}
                                   <td style="text-align: center; padding: 8px;">
                                        <a href="{{ path('demande_pdf', {token: demande.token}) }}" class="btn btn-primary btn-pdf">
                                            <i class="fas fa-file-pdf"></i>
                                        </a>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                        <a href="{{ path('valider_demandes', {id: demande.id}) }}" >
                                         <i class="fas fa-check"></i>
                                        </a>
                                    </td>
                                    
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
