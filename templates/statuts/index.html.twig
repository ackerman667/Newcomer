{% extends 'layout_ag.html.twig' %}
{% block title %}<title>Aide - {{ monApplication.Appli }}</title>{% endblock %}
{% block head_gene %}
    <style>
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            padding: 10px;
            text-align: center;
            border-bottom: 1px solid #ddd;
        }
        th {
            background-color: #f4f4f4;
        }
        tr:hover {
            background-color: #f1f1f1;
        }
        .link-modifier {
            color: #007bff;
            text-decoration: none;
        }
        .link-modifier:hover {
            text-decoration: underline;
        }
        .no-pdf {
            color: #aaa;
        }
        .status-pending {
            color: red;
        }
        .status-treated {
            color: green;
        }
        .status-other {
            color: gray;
        }
    </style>
{% endblock %}
{% block body %}<body class="page not-home">{% endblock %}
{% block header %}
    <h3 class="page-title">Historique de vos demandes</h3>
{% endblock %}
{% block main %}
    <table>
        <thead>
            <tr>
                <th>Titre</th>
                <th>Date de soumission</th>
                <th>Heure de soumission</th>
                <th>Statut</th>
                <th>Modifier la demande</th>
                <th>Visualiser</th>
            </tr>
        </thead>
        <tbody>
            {% if demandes is empty %}
                <tr>
                    <td colspan="6">Vous n'avez aucune demande pour l'instant</td>
                </tr>
            {% else %}
                {% for demande in demandes %}
                    <tr>
                        <td>{{ demande.titre }}</td>
                        <td>{{ demande.date ? demande.date|date('d/m/Y') : '' }}</td>
                        <td>{{ demande.heureSoumission ? demande.heureSoumission|date('H:i') : '' }}</td>
                        <td>
                            {% if demande.statuts == 'En attente' %}
                                <span class="status-pending">{{ demande.statuts }}</span>
                            {% elseif demande.statuts == 'Traitée' %}
                                <span class="status-treated">{{ demande.statuts }}</span>
                            {% else %}
                                <span class="status-other">{{ demande.statuts }}</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if demande.statuts == 'En attente' %}
                                <a href="{{ path('modifier_demandes', {id: demande.id}) }}" class="link-modifier">Modifier</a>
                            {% else %}
                                <span style="color: gray;" title="La demande ne peut pas être modifiée car elle a déjà été traitée">Modifier</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if demande.pdf %}
                                <a href="data:application/pdf;base64,{{ demande.pdf }}" target="_blank">Voir le PDF</a>
                            {% else %}
                                <span class="no-pdf">Aucun PDF disponible</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            {% endif %}
        </tbody>
    </table>
{% endblock %}
