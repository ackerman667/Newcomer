{% extends 'layout_ag.html.twig' %}

{% block title %}
    <title>Demandes Validées - {{ monApplication.Appli }}</title>
{% endblock %}

{% block head_gene %}
 <link rel="stylesheet" href="{{ asset('css/detan.css') }}">
 
{% endblock %}

{% block body %}
    {# <body class="page not-home"> #}
{% endblock %}

{% block header %}
    <h3 class="page-title">Demandes Validées</h3>
{% endblock %}

{% block main %}
    <div class="container table-container">
        <div class="row justify-content-center">
            <div class="col-md-12">
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">
                        {{ message }}
                    </div>
                {% endfor %}

                <div class="filter-container">
                    <label for="filter-select">Filtrer par UID:</label>
                    <select id="filter-select" class="form-select">
                        <option value="all">Tout</option>
                        <option value="no-uid">Pas d'UID</option>
                        <option value="has-uid">Modifier UID</option>
                        <option value="uid-non-modifiable">UID non modifiable</option>
                    </select>
                </div>

                <table>
                    <thead>
                        <tr>
                            {# <th class="col-id">ID Demande</th> #}
                            {# <th class="col-service">Service</th> #}
                            <th class="demandeur-column">Demandeur</th>
                            <th class="col-mail">Mail Utilisateur</th>
                             <th class="col-date">Date Validation</th>
                           <th class="col-commentaire">Commentaire</th>
                            <th>UID</th>
                            <th class="col-entreruid">Entrer UID</th>
                            <th class="col-historique">Historique</th> 

                        </tr>
                    </thead>
                    <tbody>
                        {% if demandesWithProvenance is empty %}
                            <tr>
                                <td colspan="9">Vous n'avez aucune demande pour l'instant</td>
                            </tr>
                        {% else %}
                            {% for demandeInfo in demandesWithProvenance %}
                                {% set demande = demandeInfo.demande %}
                                {% set provenance = demandeInfo.provenance %}
                                <tr data-status="{{ demande.statuts }}" data-uid="{{ demande.IDutilisateur.uid }}"data-provenance="{{ demande.IDutilisateur.provenance }}">
                                    {# <td>{{ demande.id }}</td> #}
                                    {# <td>{{ demande.service }}</td> #}


                                    <td class="demandeur-column">
                         {% if demande.isAutrePersonne %}
                                    {{ demande.AutreUtilisateur.nom }} {{ demande.AutreUtilisateur.prenom }}
                                   
                                {% else %}
                                  {{ demande.IDutilisateur.nom }} {{ demande.IDutilisateur.prenom }}
                                   {% if demande.IDutilisateur.id in alertUsers %}
                                                <span class="alert-icon" title="Cette personne a plus d'une demande en cours.">&#9888;</span>
                                            {% endif %}
                                {% endif %}
                            </td>

                                    {# {% if demande.isAutrePersonne %}
                                        <td>{{ demande.autreUtilisateur.nom }} {{ demande.autreUtilisateur.prenom }}</td>
                                    {% else %}
                                        <td>
                                            {{ demande.IDutilisateur.nom }} {{ demande.IDutilisateur.prenom }}
                                            {% if demande.IDutilisateur.id in alertUsers %}
                                                <span class="alert-icon" title="Cette personne a plus d'une demande en cours.">&#9888;</span>
                                            {% endif %}
                                        </td> #}
                                    {# {% endif %} #}
                                    <td>{{ demande.IDutilisateur.email }}</td>
                                    <td>{{ demande.datevalidation ? demande.datevalidation|date('d/m/Y') : '' }}</td>
                                    <td class="col-commentaire">
    <div class="comment-container">
        {% if demande.commentaire and demande.commentaire|length > 77 %}
            <!-- Affichage court avec "Voir plus" -->
            <div class="short-comment">
                {{ demande.commentaire|slice(0, 77) ~ '...' }}
                <span class="toggle-link" onclick="toggleComment(this)">[Voir plus]</span>
            </div>

            <!-- Affichage complet avec "Réduire" -->
            <div class="full-comment" style="display: none;">
                {{ demande.commentaire }}
                <span class="toggle-link" onclick="toggleComment(this)">[Réduire]</span>
            </div>
        {% else %}
            <!-- Si le commentaire est court -->
            <span>{{ demande.commentaire ?: 'Aucun commentaire' }}</span>
        {% endif %}
    </div>
</td>
                                    <td>
                                        {% if not demande.IDutilisateur.uid %}
                                            <span class="text-danger">Pas d'UID</span>
                                        {% else %}
                                            {{ demande.IDutilisateur.uid }}
                                        {% endif %}
                                    </td>
               <td>
    <form action="{{ path('ajouter_uid', {id: demande.IDutilisateur.id}) }}" method="post" class="input-group" style="flex-direction: column; align-items: flex-start;">
        {% if demande.IDutilisateur.provenance == 'ldap' %}
            <div style="display: flex; width: 100%;">
                <input type="text" name="uid" placeholder="Entrer UID" class="form-control input-uid" disabled style="background-color: #e9ecef; cursor: not-allowed; flex: 1;">
                <button type="button" class="btn btn-secondary" disabled style="cursor: not-allowed; margin-left: 5px;">Ajouter</button>
            </div>
            <small class="text-info" style="margin-top: 5px; color: #6c757d;">La personne à l'origine de la demande existe déjà dans l'annuaire.</small>
        {% else %}
            <div style="display: flex; width: 100%;">
                <input type="text" name="uid" placeholder="Entrer UID" class="form-control input-uid" style="flex: 1;">
                <button type="submit" class="btn btn-primary" style="margin-left: 5px;">Ajouter</button>
            </div>
        {% endif %}
    </form>

   {% if demande.IDutilisateur.uid and demande.IDutilisateur.provenance != 'ldap' %}
    <form action="{{ path('supprimer_uid', {id: demande.IDutilisateur.id}) }}" method="post" style="display: inline;">
        <button type="submit" class="btn-link text-muted" style="border: none; background: none; cursor: pointer; font-size: 0.9em; padding: 0;">
            Supprimer UID
        </button>
    </form>
{% endif %}
</td>

  <td class="toolbar">
<a href="{{ path('historique', {id: demande.id}) }}" title="Voir l'historique">
    <i class="fa-solid fa-clock-rotate-left"></i>
</a>

</td>

                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const filterSelect = document.getElementById('filter-select');
            const rows = document.querySelectorAll('tbody tr');

            filterSelect.addEventListener('change', function () {
                const filterValue = filterSelect.value;
                rows.forEach(row => {
                    const uid = row.getAttribute('data-uid');
                     const provenance = row.getAttribute('data-provenance');

                    if (filterValue === 'all') {
                row.style.display = '';
            } else if (filterValue === 'no-uid' && (!uid || uid === 'null')) {
                row.style.display = '';
            } else if (filterValue === 'has-uid' && uid && provenance !== 'ldap') {
                row.style.display = ''; 
            } else if (filterValue === 'uid-non-modifiable' && provenance === 'ldap') {
                row.style.display = ''; 
            } else {
                row.style.display = 'none';
            }
                });
            });

            setTimeout(function () {
                let alerts = document.querySelectorAll('.alert');
                alerts.forEach(function (alert) {
                    alert.classList.remove('show');
                    alert.classList.add('fade');
                });
            }, 5000); 
        });


        function toggleComment(toggleLink) {
    const shortComment = toggleLink.closest('.comment-container').querySelector('.short-comment');
    const fullComment = toggleLink.closest('.comment-container').querySelector('.full-comment');

    if (shortComment.style.display === 'none') {
        shortComment.style.display = 'block';
        fullComment.style.display = 'none';
    } else {
        shortComment.style.display = 'none';
        fullComment.style.display = 'block';
    }
}

    </script>
{% endblock %}
