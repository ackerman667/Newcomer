{% extends 'layout_ag.html.twig' %}

{% block title %}
    <title>Réinitialisation du mot de passe - {{monApplication.Appli}}</title>
{% endblock %}

{% block head_gene %}
    <script type="text/javascript" src="{{ asset('js/documentation.js', 'interfaceappli') }}" defer></script>
    <style>
        .reset-password-container {
            max-width: 400px;
            margin: 0 auto;
            padding: 20px;
            background-color: #f9f9f9;
            border: 1px solid #ddd;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }
        .reset-password-container h1 {
            text-align: center;
            font-size: 24px;
            margin-bottom: 20px;
        }
        .reset-password-form .form-group {
            margin-bottom: 15px;
        }
        .reset-password-form .btn-primary {
            width: 100%;
        }
        .alert {
            padding: 10px 15px;
            margin-bottom: 15px;
            border: 1px solid transparent;
            border-radius: 4px;
        }
        .alert-success {
            color: #3c763d;
            background-color: #dff0d8;
            border-color: #d6e9c6;
        }
        .alert-danger {
            color: #a94442;
            background-color: #f2dede;
            border-color: #ebccd1;
        }
    </style>
{% endblock %}

{% block body %}
<body class="page not-home">
{% endblock %}

{% block header %}
    <div class="title_app" id="title">
        <h1 class="title">{{monApplication.Appli}}</h1>
        <h2 class="desc">{{monApplication.LibAppli}}</h2>
    </div>
    <div class="title_image">
        <span>Rectorat</span>
    </div>
{% endblock %}

{% block main %}
<div class="reset-password-container">
    <h1>Réinitialisation du mot de passe</h1>

    {# Affichage des messages de succès ou d'erreur #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
    {% endfor %}

    <p>Veuillez saisir votre nouveau mot de passe ci-dessous :</p>

    <form method="post" class="reset-password-form">
        <div class="form-group">
            <label for="password">Nouveau mot de passe</label>
            <input type="password" id="password" name="password" class="form-control" placeholder="Entrez votre nouveau mot de passe" required>
        </div>

        <div class="form-group">
            <label for="confirm_password">Confirmez le mot de passe</label>
            <input type="password" id="confirm_password" name="confirm_password" class="form-control" placeholder="Confirmez votre nouveau mot de passe" required>
        </div>

        <button type="submit" class="btn btn-primary">Réinitialiser le mot de passe</button>
    </form>
</div>
{% endblock %}
