{% extends 'layout_ag.html.twig' %}

{% block title %}
    <title>Réinitialisation du mot de passe - {{monApplication.Appli}}</title>
{% endblock %}

{% block body %}
<body class="page not-home">
{% endblock %}

{% block header %}
    <h1 class="page-title">Réinitialisation du mot de passe</h1>
{% endblock %}

{% block main %}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            {# Afficher les messages de flash "success" et "error" #}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">
                    {{ message }}
                </div>
            {% endfor %}
            
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger">
                    {{ message }}
                </div>
            {% endfor %}

            <div class="forgot-password-container">
                <p>Entrez votre adresse e-mail ci-dessous. Si elle est associée à un compte, nous vous enverrons un lien pour réinitialiser votre mot de passe.</p>

                <form method="post" class="forgot-password-form">
                    <div class="form-group">
                        <label for="email">Adresse e-mail</label>
                        <input type="email" id="email" name="email" class="form-control" placeholder="Votre adresse e-mail" required>
                    </div>

                    <button type="submit" class="btn btn-primary">Envoyer le lien de réinitialisation</button>
                </form>

                <div class="back-to-login">
                    <p><a href="{{ path('app_login') }}">Retour à la page de connexion</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .forgot-password-container {
        max-width: 400px;
        margin: 0 auto;
        padding: 20px;
        background-color: #f9f9f9;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }
    .forgot-password-container h1 {
        text-align: center;
        font-size: 24px;
        margin-bottom: 20px;
    }
    .forgot-password-form .form-group {
        margin-bottom: 15px;
    }
    .forgot-password-form .btn-primary {
        width: 100%;
    }
    .back-to-login {
        text-align: center;
        margin-top: 10px;
    }
    .alert {
        padding: 10px 15px;
        margin-bottom: 15px;
        border: 1px solid transparent;
        border-radius: 4px;
    }
    .alert-success {
        color: #3c763d;
        background-color: #dff0d8;
        border-color: #d6e9c6;
    }
    .alert-danger {
        color: #a94442;
        background-color: #f2dede;
        border-color: #ebccd1;
    }
</style>
{% endblock %}
