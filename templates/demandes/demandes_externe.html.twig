function handleNouvelleDemandeClick(event) {
    event.preventDefault();
    const demandeEnCours = {{ demandeEnCours|default(false) ? 'true' : 'false' }};

    if (demandeEnCours) {
        const modal = new bootstrap.Modal(document.getElementById('modalNouvelleDemande'));
        modal.show();
    } else {
        window.location.href = "{{ path('nouvelle_demande') }}";
    }
}




    </script>
{% endblock %}
