{% extends 'layout_ag.html.twig' %}
{% block title %}<title>Historique de vos demandes - {{ monApplication.Appli }}</title>{% endblock %}
{% block head_gene %}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
 <link rel="stylesheet" href="{{ asset('css/externes-demandes.css') }}">
<script>
    const logoutUrl = '{{ path('app_logout') }}'; // Générer l'URL dynamique
</script>
<script type="text/javascript" src="{{ asset('js/inactivity.js') }}" defer></script>
    <style>
       
    </style>
{% endblock %}
{% block body %}
{# <body class="page not-home"> #}
{% endblock %}
{% block header %}

    
{% endblock %}
{% block main %}
{% set hasDraft = false %}
{% for demande in demandes %}
    {% if demande.statuts == 'Brouillons' %}
        {% set hasDraft = true %}
    {% endif %}
{% endfor %}

{% if hasDraft %}
<div class="disclaimer-container">
    <p>
        ⚠️ <b></b> Si vous n'avez plus d'ajustements à faire sur la demande, veuillez la valider afin qu'elle soit transmise à votre supérieur hiérarchique
    </p>
</div>
<div class="container table-container with-warning">
{% else %}
<div class="container table-container no-warning">


{% endif %}
   <div class="container table-container">
    <div class="row justify-content-center">
        <div class="col-12">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">
                    {{ message }}
                </div>
            {% endfor %}
    <div class="btn-container">
          <a href="#" onclick="handleNouvelleDemandeClick(event)" class="custom-link">
    <i class="fas fa-plus-circle fa-lg"></i>
    <b>Nouvelle demande personnelle</b>
</a>

    </div>

            <table class="table table-striped">
                
                    <thead>
                        <tr>
                
    
                            <th class="col-service">Service</th>
                           
                              <th class="col-date">Date soumission</th>
            <th class="col-heure">Heure soumission</th>
                            <th class="col-statut">Statut</th>
                            <th class="col-commentaire">Commentaire</th>
                             <th class="col-actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if demandes is empty %}
                            <tr>
                                <td colspan="6" class="text-center">Vous n'avez aucune demande pour l'instant</td>
                            </tr>
                        {% else %}
                            {% for demande in demandes %}
                                <tr>
                                    <td style="text-align: center; padding: 8px; color: #00008B; font-weight: bold;">{{ demande.service }}</td>
                                 {% if demande.statuts != 'Brouillons' %}
                      <td class="text-center">{{ demande.date ? demande.date|date('d/m/Y') : '' }}</td>
                                    <td class="text-center">{{ demande.heureSoumission ? demande.heureSoumission|date('H:i') : '' }}</td>
                        {% else %}
    <td class="text-center">&nbsp;</td>
    <td class="text-center">&nbsp;</td>
{% endif %}
                                    
                                    <td class="text-center">
                                        <span class="{% if demande.statuts == 'Brouillons' %}status-brouillons{% elseif demande.statuts == 'Suivi dans LEKA' %}status-leka{% elseif demande.statuts == 'En attente' %}status-en-attente{% elseif demande.statuts == 'Refusée' %}status-refuse{% endif %}">{{ demande.statuts }}</span>
                                    </td>
                                                    <td class="col-commentaire">
    <div class="comment-container">
        {% if demande.commentaire and demande.commentaire|length > 50 %}
          
            <div class="short-comment">
                {{ demande.commentaire|slice(0, 50) ~ '...' }}
                <span class="toggle-link" onclick="toggleComment(this)">[Voir plus]</span>
            </div>

            <div class="full-comment" style="display: none;">
                {{ demande.commentaire }}
                <span class="toggle-link" onclick="toggleComment(this)">[Réduire]</span>
            </div>
        {% else %}
          
            <span>{{ demande.commentaire ?: 'Aucun commentaire' }}</span>
        {% endif %}
    </div>
</td>
                                    <td class="toolbar">
                                        {% if demande.statuts == 'Brouillons' %}
                                            <a href="{{ path('modifier_demandes', {id: demande.id}) }}" title="Modifier"><i class="fas fa-edit icon-edit"></i></a>
                                            <a href="{{ path('demande_consult', {id: demande.id}) }}" title="Consulter"><i class="fas fa-search icon-search"></i></a>
                                            <a href="{{ path('formulaireexterne_supprimer', {id: demande.id}) }}" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette demande ?');" title="Supprimer"><i class="fas fa-trash-alt icon-trash"></i></a>
                                            <a href="{{ path('valider_demandes', {id: demande.id}) }}" title="Valider"><i class="fas fa-thumbs-up icon-thumbs-up"></i></a>
                                            {# <a href="{{ path('demande_pdf', {id: demande.id}) }}" title="Télécharger PDF"><i class="fas fa-file-pdf icon-pdf"></i></a> #}
                                        {% else %}
                                            <a href="{{ path('demande_consult', {id: demande.id}) }}" title="Consulter"><i class="fas fa-search icon-search"></i></a>
                                            <a href="{{ path('demande_pdf', {id: demande.id}) }}" title="Télécharger PDF"><i class="fas fa-file-pdf icon-pdf"></i></a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{# Modal Bootstrap pour choix de demande #}
<div class="modal fade" id="modalNouvelleDemande" tabindex="-1" aria-labelledby="labelModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="POST" action="{{ path('nouvelle_demande') }}">
                <div class="modal-header">
                    <h5 class="modal-title" id="labelModal">Demande en cours</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body">
                    <p>Vous avez déjà une demande en cours non finalisée.</p>
                    <p>Souhaitez-vous la reprendre ou recommencer depuis zéro ?</p>
                </div>
               <div class="modal-footer d-flex gap-2 justify-content-end">
    <button type="submit" name="choix_demande" value="reinitialiser" class="btn btn-danger">Réinitialiser</button>
    <a href="{{ path('nouvelle_demande') }}" class="btn btn-primary">Reprendre</a>
</div>
            </form>
        </div>
    </div>
</div>
    <script>
    document.addEventListener('DOMContentLoaded', function () {
    setTimeout(function () {
        let alerts = document.querySelectorAll('.alert');
        alerts.forEach(function (alert) {
            alert.classList.add('fade');
        });
    }, 5000); // Disparition après 5 secondes
});
// Ajouter un écouteur de `pageshow` pour détecter le retour arrière
window.addEventListener('pageshow', function(event) {
    if (event.persisted || performance.navigation.type === 2) {
        // Reload la page lorsque l'utilisateur revient en arrière dans l'historique
        window.location.reload();
    }
});
function toggleComment(toggleLink) {
    const shortComment = toggleLink.closest('.comment-container').querySelector('.short-comment');
    const fullComment = toggleLink.closest('.comment-container').querySelector('.full-comment');

    if (shortComment.style.display === 'none') {
        shortComment.style.display = 'block';
        fullComment.style.display = 'none';
    } else {
        shortComment.style.display = 'none';
        fullComment.style.display = 'block';
    }
}
