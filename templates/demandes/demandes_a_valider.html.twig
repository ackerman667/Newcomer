{% extends 'layout_ag.html.twig' %}

{% block title %}<title>Demandes à Valider - {{ monApplication.Appli }}</title>{% endblock %}

{% block head_gene %}
<link rel="stylesheet" href="{{ asset('css/avalider.css') }}">
{% endblock %}

{% block body %}  
<div id="popup-confirm-validation" class="modal" style="display: none;">
    <div class="modal-content">
        <p>
  📎 <a href="https://bv.ac-guadeloupe.fr/dsi/node/27496" target="_blank" rel="noopener noreferrer">
    Merci de prendre le temps de communiquer la charte des usages à l’agent. Cette charte est consultable à ce lien.
  </a>
</p>

        <div class="modal-buttons">
            <button id="btn-confirm-validation">Valider</button>
            <button id="btn-cancel-validation">Annuler</button>
        </div>
    </div>
</div>
{% endblock %}

{% block header %}
<div class="menu-container">
    {{ include('./demandes/menu.html.twig') }}
</div>
{% endblock %}

{% block main %}
<div class="container table-container">
    <div class="row justify-content-center">
        <div class="col-md-12">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}
        </div>
    </div>

    <div class="filter-container">
        <label for="filter-select">Filtrer par statut :</label>
        <select id="filter-select" class="form-select">
            <option value="all">Tout</option>
            <option value="Suivi dans LEKA">Suivi dans LEKA</option>
            <option value="En attente">En attente</option>
            <option value="Refusée">Refusée</option>
        </select>
    </div>

    <table class="table table-striped">
        <thead>
            <tr>
                <th class="col-service">Service</th>
                <th class="demandeur-column">Demandeur</th>
                <th class="col-date">Date soumission</th>
                <th class="col-heure">Heure soumission</th>
                <th class="col-statut">Statut</th>
                <th class="col-commentaire">Commentaire</th>
                <th class="col-actions">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% if demandesAValider is empty %}
                <tr><td colspan="7">Aucune demande à valider pour l'instant</td></tr>
            {% else %}
                {% for demande in demandesAValider %}
                    <tr data-status="{{ demande.statuts }}">
                        <td class="service-column">{{ demande.service }}</td>
                        <td class="demandeur-column">
                            {% if demande.isAutrePersonne %}
                                {{ demande.AutreUtilisateur.nom }} {{ demande.AutreUtilisateur.prenom }}
                            {% else %}
                                {{ demande.IDutilisateur.nom }} {{ demande.IDutilisateur.prenom }}
                            {% endif %}
                        </td>
                        <td>{{ demande.date ? demande.date|date('d/m/Y') : '' }}</td>
                        <td>{{ demande.heureSoumission ? demande.heureSoumission|date('H:i') : '' }}</td>
                        <td>
                            <span class="{% if demande.statuts == 'Suivi dans LEKA' %}status-leka{% elseif demande.statuts == 'En attente' %}status-en-attente{% elseif demande.statuts == 'Refusée' %}status-refuse{% endif %}">
                                {{ demande.statuts }}
                            </span>
                        </td>
                        <td class="col-commentaire">
                            <div class="comment-container">
                                {% if demande.statuts != 'En attente' %}
                                    {% if demande.commentaire and demande.commentaire|length > 50 %}
                                        <div class="short-comment">
                                            {{ demande.commentaire|slice(0, 50) ~ '...' }}
                                            <span class="toggle-link" onclick="toggleComment(this)">[Voir +]</span>
                                        </div>
                                        <div class="full-comment" style="display: none;">
                                            {{ demande.commentaire }}
                                            <span class="toggle-link" onclick="toggleComment(this)">[Réduire]</span>
                                        </div>
                                    {% else %}
                                        <span>{{ demande.commentaire ?: 'Aucun commentaire' }}</span>
                                    {% endif %}
                                {% else %}
                                    <form class="comment-form" method="post" action="{{ path('commenter_demande', {id: demande.id}) }}">
                                        <textarea id="commentaire-{{ demande.id }}" name="commentaire" rows="2" maxlength="250" placeholder="Ajouter un commentaire en cas de refus !">{{ demande.commentaire }}</textarea>
                                    </form>
                                {% endif %}
                            </div>
                        </td>
                        <td class="toolbar">
                            {% if demande.statuts == 'En attente' %}
                                <a href="{{ path('preparer_modification_valideur', {id: demande.id}) }}"><i class="fas fa-edit"></i></a>
                                <a href="{{ path('visualiser_demande', {id: demande.id}) }}"><i class="fas fa-search"></i></a>
                                <a href="#" class="btn-valider-popup" data-id="{{ demande.id }}" data-url="{{ path('valider_demande', {id: demande.id}) }}"><i class="fas fa-thumbs-up"></i></a>
                                <a href="{{ path('demande_pdf_valideur', {id: demande.id}) }}"><i class="fas fa-file-pdf"></i></a>
                                <a href="{{ path('refuser_demande', {id: demande.id}) }}" onclick="return checkComment('{{ demande.id }}')"><i class="fas fa-thumbs-down"></i></a>
                            {% else %}
                                <a href="{{ path('visualiser_demande', {id: demande.id}) }}"><i class="fas fa-search"></i></a>
                                <a href="{{ path('demande_pdf_valideur', {id: demande.id}) }}"><i class="fas fa-file-pdf"></i></a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            {% endif %}
        </tbody>
    </table>
</div>

<script>
let demandeIdToValidate = null;

function autoResizeTextarea(textarea) {
    textarea.style.height = 'auto';
    textarea.style.height = textarea.scrollHeight + 'px';
}

function toggleComment(link) {
    const container = link.closest('.comment-container');
    const shortComment = container.querySelector('.short-comment');
    const fullComment = container.querySelector('.full-comment');

    if (shortComment && fullComment) {
        const isShortVisible = shortComment.style.display !== 'none';

        shortComment.style.display = isShortVisible ? 'none' : 'block';
        fullComment.style.display = isShortVisible ? 'block' : 'none';
    }
}

function checkComment(demandeId) {
    const commentaireElement = document.getElementById('commentaire-' + demandeId);
    const form = commentaireElement.closest('form');
    const commentaire = commentaireElement.value.trim();

    if (!commentaire) {
        alert('Veuillez ajouter un commentaire avant de refuser la demande.');
        commentaireElement.focus();
        return false;
    }

    const formData = new FormData(form);
    fetch(form.action, {
        method: 'POST',
        body: formData
    }).then(response => {
        if (response.ok) {
            window.location.href = "{{ path('refuser_demande', {'id': 'ID_DEMANDE'}) }}".replace('ID_DEMANDE', demandeId);
        } else {
            alert('Erreur lors de la soumission du commentaire.');
        }
    }).catch(() => alert('Erreur réseau'));

    return false;
}

document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('textarea').forEach(textarea => {
        autoResizeTextarea(textarea);
        textarea.addEventListener('input', () => autoResizeTextarea(textarea));
    });

    document.querySelectorAll('.btn-valider-popup').forEach(btn => {
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            demandeIdToValidate = this.dataset.id;
            document.getElementById('popup-confirm-validation').style.display = 'flex';
        });
    });

    document.getElementById('btn-cancel-validation').addEventListener('click', () => {
        document.getElementById('popup-confirm-validation').style.display = 'none';
        demandeIdToValidate = null;
    });

    document.getElementById('btn-confirm-validation').addEventListener('click', () => {
        if (!demandeIdToValidate) return;
        const commentaireElement = document.getElementById('commentaire-' + demandeIdToValidate);
        const url = document.querySelector(`[data-id="${demandeIdToValidate}"]`).dataset.url;

        if (commentaireElement && commentaireElement.value.trim() !== '') {
            const form = commentaireElement.closest('form');
            const formData = new FormData(form);
            fetch(form.action, {
                method: 'POST',
                body: formData
            }).then(response => {
                if (response.ok) {
                    window.location.href = url;
                } else {
                    alert('Le commentaire n\'a pas pu être enregistré.');
                }
            }).catch(() => alert('Erreur lors de l\'enregistrement du commentaire.'));
        } else {
            window.location.href = url;
        }

        document.getElementById('popup-confirm-validation').style.display = 'none';
    });

    const filterSelect = document.getElementById('filter-select');
    const rows = document.querySelectorAll('tbody tr');
    if (filterSelect) {
        filterSelect.addEventListener('change', function () {
            const value = this.value;
            rows.forEach(row => {
                const status = row.getAttribute('data-status');
                row.style.display = (value === 'all' || value === status) ? '' : 'none';
            });
        });
    }

    setTimeout(() => {
        document.querySelectorAll('.alert').forEach(alert => {
            alert.style.transition = 'opacity 1s ease-out';
            alert.style.opacity = '0';
            alert.addEventListener('transitionend', () => alert.remove());
        });
    }, 5000);
});
</script>
{% endblock %}