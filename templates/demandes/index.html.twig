{% extends 'layout_ag.html.twig' %}
{% block title %}<title>Gestion des Demandes - {{ monApplication.Appli }}</title>{% endblock %}

{% block head_gene %}
<style>
    .page-title {
        text-align: center;
        margin: 20px 0;
    }
    .table-container {
        margin: 20px auto;
        width: 90%;
    }
    table {
        width: 100%;
        border-collapse: collapse;
    }
    th, td {
        text-align: center;
        padding: 12px;
        border-bottom: 1px solid #ddd;
    }
    th {
        background-color: #f8f8f8;
    }
    .status-leka {
        background-color: #28A745;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        display: inline-block;
        min-width: 100px;
        margin: 5px 0;
    }
    .status-en-attente {
        background-color: #FFC107;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        display: inline-block;
        min-width: 100px;
        margin: 5px 0;
    }
    .status-refuse {
        background-color: #FF0000; 
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        display: inline-block;
        min-width: 100px;
        margin: 5px 0;
    }
    .status-brouillons {
        background-color: #D3D3D3;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        display: inline-block;
        min-width: 100px;
        margin: 5px 0;
    }
    .comment-form textarea {
        width: 100%;
        margin-bottom: 5px;
    }
    .comment-form textarea[disabled],
    .comment-form button[disabled] {
        background-color: #f1f1f1;
        cursor: not-allowed;
    }
    .toolbar {
        text-align: right;
        color: #1E90FF;
    }
    .toolbar a {
        margin-left: 10px;
        color: #1E90FF !important;
    }
    .toolbar a i {
        color: #1E90FF !important;
    }
    .col-demandeur {
        width: 15%;
    }
    .filter-container {
        margin-bottom: 20px;
    }
    .service-column {
        color: blue;
        font-weight: bold;
    }
    .alert {
        transition: height 0.5s ease, opacity 0.5s ease;
        overflow: hidden;
        height: auto;
        opacity: 1;
    }
    .alert.fade {
        height: 0;
        opacity: 0;
        padding: 0;
        margin: 0;
    }
    .btn-container {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-bottom: 20px;
    }
    .btn-primary {
        padding: 10px 20px;
    }
</style>
{% endblock %}

{% block body %}<body class="page not-home">{% endblock %}

{% block header %}
<h3 class="page-title">Gestion des Demandes</h3>
{% endblock %}

{% block main %}
<div class="container table-container">
    <div class="row justify-content-center">
        <div class="col-md-12">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">
                    {{ message }}
                </div>
            {% endfor %}

            <!-- Section de boutons pour faire de nouvelles demandes -->
            <div class="btn-container">
                <a href="{{ path('nouvelle-demande-ldap') }}" class="btn btn-primary">Faire une demande pour quelqu'un d'autre</a>
                <a href="{{ path('nouvelle_demande_ldap') }}" class="btn btn-primary">Nouvelle demande personnelle</a>
            </div>

            <!-- Section Demandes à Valider (uniquement pour les valideurs) -->
            {% if isValideur and demandesAValider is not empty %}
                <h4 class="text-center mt-4">Demandes à Valider</h4>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th class="col-demandeur">Demandeur</th>
                            <th class="col-service">Service</th>
                            <th>Date de soumission</th>
                            <th>Heure de soumission</th>
                            <th>Statut</th>
                            <th>Ajouter un commentaire</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for demande in demandesAValider %}
                            <tr data-status="{{ demande.statuts }}">
                                <td>{{ demande.IDutilisateur.nom }} {{ demande.IDutilisateur.prenom }}</td>
                                <td class="service-column">{{ demande.service }}</td>
                                <td>{{ demande.date ? demande.date|date('d/m/Y') : '' }}</td>
                                <td>{{ demande.heureSoumission ? demande.heureSoumission|date('H:i') : '' }}</td>
                                <td>
                                    <span class="{% if demande.statuts == 'Suivi dans LEKA' %}status-leka{% elseif demande.statuts == 'En attente' %}status-en-attente{% elseif demande.statuts == 'Refusée' %}status-refuse{% endif %}">
                                        {{ demande.statuts }}
                                    </span>
                                </td>
                                <td>
                                    <form class="comment-form" method="post" action="{{ path('commenter_demande', {id: demande.id}) }}">
                                        <textarea id="commentaire-{{ demande.id }}" name="commentaire" rows="2" placeholder="Ajouter un commentaire en cas de refus !" {% if demande.statuts == 'Suivi dans LEKA' or demande.statuts == 'Refusée' %}disabled{% endif %}>{{ demande.commentaire ? demande.commentaire : '' }}</textarea>
                                        <button type="submit" {% if demande.statuts is not same as('En attente') %}disabled{% endif %}>Ajouter un commentaire !</button>
                                    </form>
                                </td>
                                <td class="toolbar">
                                    {% if demande.statuts == 'En attente' %}
                                        <a href="{{ path('modifier_demandesvalideur_etape1', {id: demande.id}) }}">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="{{ path('visualiser_demande', {id: demande.id}) }}">
                                            <i class="fas fa-search"></i>
                                        </a>
                                        <a href="{{ path('valider_demande', {id: demande.id}) }}">
                                            <i class="fas fa-thumbs-up"></i>
                                        </a>
                                        <a href="{{ path('demande_pdf_valideur', {id: demande.id}) }}">
                                            <i class="fas fa-file-pdf"></i>
                                        </a>
                                        <a href="{{ path('refuser_demande', {id: demande.id}) }}" onclick="return checkComment('{{ demande.id }}')">
                                            <i class="fas fa-thumbs-down"></i>
                                        </a>
                                    {% else %}
                                        <a href="{{ path('visualiser_demande', {id: demande.id}) }}">
                                            <i class="fas fa-search"></i>
                                        </a>
                                        <a href="{{ path('demande_pdf_valideur', {id: demande.id}) }}">
                                            <i class="fas fa-file-pdf"></i>
                                        </a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}

            <!-- Section Mes Demandes -->
         <h4 class="text-center mt-4">Mes Demandes</h4>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Service</th>
            <th>Demandeur</th>
            <th>Date de soumission</th>
            <th>Heure de soumission</th>
            <th>Statut</th>
            <th>Commentaire</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% if mesDemandes is empty %}
            <tr>
                <td colspan="7">Vous n'avez aucune demande pour l'instant</td>
            </tr>
        {% else %}
            {% for demande in mesDemandes %}
                <tr data-status="{{ demande.statuts }}">
                    <td>{{ demande.service }}</td>
                    
                    {% if demande.isAutrePersonne %}
                        {% set infosPersonne = demande.infosPersonne %}
                        <td>{{ infosPersonne.nom }} {{ infosPersonne.prenom }}</td>
                    {% else %}
                        <td>{{ demande.IDutilisateur.nom }} {{ demande.IDutilisateur.prenom }}</td>
                    {% endif %}
                    
                    <td>{{ demande.date ? demande.date|date('d/m/Y') : '' }}</td>
                    <td>{{ demande.heureSoumission ? demande.heureSoumission|date('H:i') : '' }}</td>
                    <td>
                        <span class="{% if demande.statuts == 'Brouillons' %}status-brouillons{% elseif demande.statuts == 'Suivi dans LEKA' %}status-leka{% elseif demande.statuts == 'En attente' %}status-en-attente{% elseif demande.statuts == 'Refusée' %}status-refuse{% endif %}">
                            {{ demande.statuts }}
                        </span>
                    </td>
                    <td>{{ demande.commentaire ? demande.commentaire : 'Aucun commentaire' }}</td>
                    <td class="toolbar">
                        {% if demande.isAutrePersonne %}
                            {# Actions pour les demandes faites pour une autre personne #}
                            {% if demande.statuts == 'Brouillons' %}
                                <a href="{{ path('modifier_demandespourautre', {id: demande.id}) }}">
                                    <i class="fas fa-edit icon-edit"></i>
                                </a>
                                <a href="{{ path('demande_consult_ldap', {token: demande.token}) }}">
                                    <i class="fas fa-search icon-search"></i>
                                </a>
                                <a href="{{ path('supprimer_demandespourautre', {id: demande.id}) }}" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette demande ?');">
                                    <i class="fas fa-trash-alt icon-trash"></i>
                                </a>
                                <a href="{{ path('valider_demandespourautre', {id: demande.id}) }}">
                                    <i class="fas fa-thumbs-up icon-thumbs-up"></i>
                                </a>
                            {% else %}
                                <a href="{{ path('demande_consult_ldap', {token: demande.token}) }}">
                                    <i class="fas fa-search icon-search"></i>
                                </a>
                                <a href="{{ path('demande_pdf_ldap', {token: demande.token}) }}">
                                    <i class="fas fa-file-pdf icon-pdf"></i>
                                </a>
                            {% endif %}
                        {% else %}
                            {# Actions pour les demandes faites pour soi-même #}
                            {% if demande.statuts == 'Brouillons' %}
                                <a href="{{ path('modifier_demandesldap', {id: demande.id}) }}">
                                    <i class="fas fa-edit icon-edit"></i>
                                </a>
                                <a href="{{ path('demande_consult_ldap', {token: demande.token}) }}">
                                    <i class="fas fa-search icon-search"></i>
                                </a>
                                <a href="{{ path('formulaireldap_supprimer', {id: demande.id}) }}" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette demande ?');">
                                    <i class="fas fa-trash-alt icon-trash"></i>
                                </a>
                                <a href="{{ path('valider_demandesldap', {id: demande.id}) }}">
                                    <i class="fas fa-thumbs-up icon-thumbs-up"></i>
                                </a>
                            {% else %}
                                <a href="{{ path('demande_consult_ldap', {token: demande.token}) }}">
                                    <i class="fas fa-search icon-search"></i>
                                </a>
                                <a href="{{ path('demande_pdf_ldap', {token: demande.token}) }}">
                                    <i class="fas fa-file-pdf icon-pdf"></i>
                                </a>
                            {% endif %}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
        {% endif %}
    </tbody>
</table>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const filterSelect = document.getElementById('filter-select');
    const rows = document.querySelectorAll('tbody tr');

    filterSelect.addEventListener('change', function() {
        const filterValue = filterSelect.value;
        rows.forEach(row => {
            const status = row.getAttribute('data-status');
            if (filterValue === 'all' || (filterValue === 'Suivi dans LEKA' && status === 'Suivi dans LEKA') || (filterValue === 'En attente' && status === 'En attente') || (filterValue === 'Refusée' && status === 'Refusée')) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });

    setTimeout(function() {
        let alerts = document.querySelectorAll('.alert');
        alerts.forEach(function(alert) {
            alert.classList.add('fade');
        });
    }, 5000);
});

function checkComment(demandeId) {
    const commentaire = document.getElementById('commentaire-' + demandeId).value.trim();
    if (commentaire === '') {
        alert('Veuillez ajouter un commentaire avant de refuser la demande.');
        return false;
    }
    return true;
}
</script>
{% endblock %}
