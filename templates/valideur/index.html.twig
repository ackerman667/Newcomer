{% extends 'layout_ag.html.twig' %}
{% block title %}<title>Historique de vos demandes - {{ monApplication.Appli }}</title>{% endblock %}
{% block head_gene %}
<style>
    .page-title {
        text-align: center;
        margin: 20px 0;
    }
    {# .table-container {
        margin: 20px auto;
        width: 90%;
    } #}
    table {
        width: 100%;
        border-collapse: collapse;
    }
    th, td {
        text-align: center;
        padding: 12px;
        border-bottom: 1px solid #ddd;
    }
    th {
        background-color: #f8f8f8;
    }
    
    .btn-disabled {
        color: gray;
        cursor: not-allowed;
    }
    .comment-form textarea {
        width: 100%;
        margin-bottom: 5px;
    }
   
</style>
{% endblock %}
{% block body %}<body class="page not-home">{% endblock %}
{% block header %}
    <h3 class="page-title">Historique de vos demandes</h3>
{% endblock %}
{% block main %}
    <div class="container table-container">
        <div class="row justify-content-center">
            <div class="col-md-12">
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">
                        {{ message }}
                    </div>
                {% endfor %}
                <table>
                    <thead>
                        <tr>
                            <th>Titre</th>
                            <th>Date de soumission</th>
                            <th>Heure de soumission</th>
                            <th>Statut</th>
                            <th>Modifier la demande</th>
                            <th>Visualiser</th>
                            <th>Commentaire</th>
                            <th>Ajouter un commentaire</th>
                            <th>Valider</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if demandes is empty %}
                            <tr>
                                <td colspan="9">Vous n'avez aucune demande pour l'instant</td>
                            </tr>
                        {% else %}
                            {% for demande in demandes %}
                                <tr>
                                    <td>{{ demande.titre }}</td>
                                    <td>{{ demande.date ? demande.date|date('d/m/Y') : '' }}</td>
                                    <td>{{ demande.heureSoumission ? demande.heureSoumission|date('H:i') : '' }}</td>
                                    <td>{{ demande.statuts }}</td>
                                    {% if demande.statuts == 'Envoyé' %}
                                        <td>
                                            <a href="{{ path('modifier_demandesvalideur_etape1', {id: demande.id}) }}" >
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </td>
                                    {% else %}
                                        <td>
                                            <span class="btn-disabled" title="La demande ne peut pas être modifiée car elle a déjà été traitée">Modifier</span>
                                        </td>
                                    {% endif %}
                                    <td>
                                        <a href="{{ path('visualiser_demande', {id: demande.id}) }}" >
                                            <i class="fas fa-search"></i>
                                        </a>
                                    </td>
                                    <td>
                                        <span>{{ demande.commentaire ? demande.commentaire : 'Aucun commentaire' }}</span>
                                    </td>
                                    <td>
                                        <form class="comment-form" method="post" action="{{ path('commenter_demande', {id: demande.id}) }}">
                                            <textarea name="commentaire" rows="2">{{ demande.commentaire ? demande.commentaire : '' }}</textarea>
                                            <button type="submit" >Commenter</button>
                                        </form>
                                    </td>
                                    <td>
                                        {% if demande.statuts != 'Validé' %}
                                              <td style="text-align: center; padding: 8px;">
                                        <a href="{{ path('valider_demande', {id: demande.id}) }}" >
                                         <i class="fas fa-check"></i>
                                        </a>
                                    </td>
                                        {% else %}
                                            <span class="btn-disabled">Déjà validé</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
