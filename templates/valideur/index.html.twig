{% extends 'layout_ag.html.twig' %}
{% block title %}<title>Aide - {{ monApplication.Appli }}</title>{% endblock %}
{% block head_gene %}
    <script type="text/javascript" src="{{ asset('js/documentation.js','interfaceappli') }}" defer></script>
{% endblock %}
{% block body %}<body class="page not-home">{% endblock %}
{% block header %}
    {# <div class="title_app" id="title">
        <h1 class="title">{{ monApplication.Appli }}</h1>
        <h2 class="desc">{{ monApplication.LibAppli }}</h2>
    </div> #}
    

{% endblock %}
{% block main %}
    <h3>Liste des demandes</h3>
  
    <table style="width:100%; border-collapse: collapse;">
        <thead>
            <tr style="border-bottom: 1px solid #ddd;">
                <th style="text-align: center; padding: 8px;">Titre</th>
                <th style="text-align: center; padding: 8px;">Nom</th>
                <th style="text-align: center; padding: 8px;">Prénom</th>
                <th style="text-align: center; padding: 8px;">Date</th>
                <th style="text-align: center; padding: 8px;">Statuts</th>
                <th style="text-align: center; padding: 8px;">Choix</th>
            </tr>
        </thead>
        <tbody>
  {# {{ dump(nomUtilisateur)}} #}
            {% for demande in demandes %}
                <tr style="border-bottom: 1px solid #ddd;">
                <td style="text-align: center; padding: 8px;">{{ demande.titre }}</td>
                 <td style="text-align: center; padding: 8px;">{{ demande.IDutilisateur.getNom() }}</td>
                    <td style="text-align: center; padding: 8px;">{{ demande.IDutilisateur.getPrenom() }}</td>
                      <td style="text-align: center; padding: 8px;">{{ demande.date ? demande.date|date('d/m/Y') : '' }}</td>
                    <td style="text-align: center; padding: 8px;">{{ demande.statuts }}</td>
                    
                  
                    
                 
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
