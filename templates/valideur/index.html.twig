{% extends 'layout_ag.html.twig' %}
{% block title %}<title>Historique de vos demandes - {{ monApplication.Appli }}</title>{% endblock %}
{% block head_gene %}
    <style>
        .details-section {
            border: 1px solid #000;
            padding: 15px;
            margin-bottom: 20px;
        }
        .details-section-title {
            font-weight: bold;
            margin-bottom: 10px;
            text-align: center;
        }
        .details-group {
            margin-bottom: 15px;
        }
        .details-group label {
            font-weight: bold;
        }
        .details-group span {
            display: block;
            margin-top: 5px;
        }
        .btn-primary {
            margin-top: 20px;
        }
        .page-title {
            text-align: center;
            font-style: italic;
            color: #04A0DB;
            margin-bottom: 30px;
        }
        .alert {
            margin-top: 20px;
            text-align: center;
        }
        .comment-form {
            margin-top: 10px;
        }
    </style>
{% endblock %}
{% block body %}<body class="page not-home">{% endblock %}
{% block header %}
    <h3 class="page-title">Historique de vos demandes</h3>
{% endblock %}
{% block main %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-10">
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">
                        {{ message }}
                    </div>
                {% endfor %}
                <table style="width:100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 1px solid #ddd;">
                            <th style="text-align: center; padding: 8px;">Titre</th>
                            <th style="text-align: center; padding: 8px;">Date de soumission</th>
                            <th style="text-align: center; padding: 8px;">Heure de soumission</th>
                            <th style="text-align: center; padding: 8px;">Statut</th>
                            <th style="text-align: center; padding: 8px;">Modifier la demande</th>
                            <th style="text-align: center; padding: 8px;">Visualiser</th>
                            <th style="text-align: center; padding: 8px;">Commentaire</th>
                            <th style="text-align: center; padding: 8px;">Ajouter un commentaire</th>
                            <th style="text-align: center; padding: 8px;">Valider</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if demandes is empty %}
                            <tr>
                                <td colspan="9" style="text-align: center; padding: 8px;">Vous n'avez aucune demande pour l'instant</td>
                            </tr>
                        {% else %}
                            {% for demande in demandes %}
                                <tr style="border-bottom: 1px solid #ddd;">
                                    <td style="text-align: center; padding: 8px;">{{ demande.titre }}</td>
                                    <td style="text-align: center; padding: 8px;">{{ demande.date ? demande.date|date('d/m/Y') : '' }}</td>
                                    <td style="text-align: center; padding: 8px;">{{ demande.heureSoumission ? demande.heureSoumission|date('H:i') : '' }}</td>
                                    <td style="text-align: center; padding: 8px;">{{ demande.statuts }}</td>
                                    {% if demande.statuts == 'En attente' %}
                                        <td style="text-align: center; padding: 8px;">
                                            <a href="{{ path('modifier_demandesvalideur', {id: demande.id}) }}">Modifier</a>
                                        </td>
                                    {% else %}
                                        <td style="text-align: center; padding: 8px;">
                                            <span style="color: gray;" title="La demande ne peut pas être modifiée car elle a déjà été traitée">Modifier</span>
                                        </td>
                                    {% endif %}
                                    <td style="text-align: center; padding: 8px;">
                                        <a href="{{ path('visualiser_demande', {id: demande.id}) }}">Voir la demande</a>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                        <span>{{ demande.commentaire ? demande.commentaire : 'Aucun commentaire' }}</span>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                        <form class="comment-form" method="post" action="{{ path('commenter_demande', {id: demande.id}) }}">
                                            <textarea name="commentaire" rows="2" cols="20"></textarea>
                                            <button type="submit" class="btn btn-primary">Commenter</button>
                                        </form>
                                    </td>
                                    <td style="text-align: center; padding: 8px;">
                                        {% if demande.statuts != 'Validé' %}
                                            <form method="post" action="{{ path('valider_demande', {id: demande.id}) }}">
                                                <button type="submit" class="btn btn-success">Valider</button>
                                            </form>
                                        {% else %}
                                            <span style="color: gray;">Déjà validé</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
