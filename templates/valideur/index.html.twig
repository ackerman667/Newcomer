{% extends 'layout_ag.html.twig' %}
{% block title %}<title>Demandes Validées - {{ monApplication.Appli }}</title>{% endblock %}
{% block head_gene %}
<style>
    .page-title {
        text-align: center;
        margin: 20px 0;
    }
    .table-container {
        margin: 20px auto;
        width: 90%;
    }
    table {
        width: 100%;
        border-collapse: collapse;
    }
    th, td {
        text-align: center;
        padding: 12px;
        border-bottom: 1px solid #ddd;
    }
    th {
        background-color: #f8f8f8;
    }
    .status-leka {
        background-color: #28A745;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        display: inline-block;
        min-width: 100px;
        margin: 5px 0;
    }
    .status-en-attente {
        background-color: #FFC107;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        display: inline-block;
        min-width: 100px;
        margin: 5px 0;
    }
    .status-refuse {
        background-color: #FF0000; 
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        display: inline-block;
        min-width: 100px;
        margin: 5px 0;
    }
    .comment-form textarea {
        width: 100%;
        margin-bottom: 5px;
    }
    .comment-form textarea[disabled],
    .comment-form button[disabled] {
        background-color: #f1f1f1;
        cursor: not-allowed;
    }
    .toolbar {
        text-align: right;
        color: #1E90FF;
    }
    .toolbar a {
        margin-left: 10px;
        color: #1E90FF !important;
    }
    .toolbar a i {
        color: #1E90FF !important;
    }
    .col-demandeur {
        width: 15%;
    }
    .filter-container {
        margin-bottom: 20px;
    }
    .service-column {
        color: blue;
        font-weight: bold;
    }
    .alert {
        transition: height 0.5s ease, opacity 0.5s ease;
        overflow: hidden;
        height: auto;
        opacity: 1;
    }

    .alert.fade {
        height: 0;
        opacity: 0;
        padding: 0; /* Pour éviter les espaces résiduels */
        margin: 0;
    }


</style>
{% endblock %}
{% block body %}<body class="page not-home">{% endblock %}
{% block header %}
<h3 class="page-title">Liste des demandes vous concernant</h3>
{% endblock %}
{% block main %}
<div class="container table-container">
    <div class="row justify-content-center">
        <div class="col-md-12">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">
                    {{ message }}
                </div>
            {% endfor %}
            <div class="filter-container">
                <label for="filter-select">Filtrer par statut:</label>
                <select id="filter-select" class="form-select">
                    <option value="all">Tout</option>
                    <option value="Suivi dans LEKA">Suivi dans LEKA</option>
                    <option value="En attente">En attente</option>
                    <option value="Refusée">Refusée</option>
                </select>
            </div>
            <table>
                <thead>
                    <tr>
                        <th class="col-demandeur">Demandeur</th>
                        <th class="col-service">Service</th>
                        <th>Date de soumission</th>
                        <th>Heure de soumission</th>
                        <th>Statut</th>
                        <th>Ajouter un commentaire</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% if demandes is empty %}
                        <tr>
                            <td colspan="8">Vous n'avez aucune demande pour l'instant</td>
                        </tr>
                    {% else %}
                        {% for demande in demandes %}
                            <tr data-status="{{ demande.statuts }}">
                                {% if demande.AutrePersonne %}
                                    {% set infosPersonne = demande.infosPersonne %}

                                    <td>{{ infosPersonne.nom }} {{ infosPersonne.prenom }}</td>
                                {% else %}
                                    <td>{{ demande.IDutilisateur.nom }} {{ demande.IDutilisateur.prenom }}</td>
                                {% endif %}
                                <td class="service-column">{{ demande.service }}</td>
                                <td>{{ demande.date ? demande.date|date('d/m/Y') : '' }}</td>
                                <td>{{ demande.heureSoumission ? demande.heureSoumission|date('H:i') : '' }}</td>
                                <td>
                                    <span class="{% if demande.statuts == 'Suivi dans LEKA' %}status-leka{% elseif demande.statuts == 'En attente' %}status-en-attente{% elseif demande.statuts == 'Refusée' %}status-refuse{% endif %}">
                                        {{ demande.statuts }}
                                    </span>
                                </td>
                                <td>
                                    <form class="comment-form" method="post" action="{{ path('commenter_demande', {id: demande.id}) }}">
                                        <textarea id="commentaire-{{ demande.id }}" name="commentaire" rows="2" placeholder="Ajouter un commentaire en cas de refus !" {% if demande.statuts == 'Suivi dans LEKA' %}disabled{% endif %}>{{ demande.commentaire ? demande.commentaire : '' }}</textarea>
                                        <button type="submit" {% if demande.statuts is not same as('En attente') %}disabled{% endif %}>Ajouter un commentaire !</button>
                                    </form>
                                </td>
                                <td class="toolbar">
                                    {% if demande.statuts == 'En attente' %}
                                        <a href="{{ path('modifier_demandesvalideur_etape1', {id: demande.id}) }}">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="{{ path('visualiser_demande', {id: demande.id}) }}">
                                            <i class="fas fa-search"></i>
                                        </a>
                                        <a href="{{ path('valider_demande', {id: demande.id}) }}">
                                            <i class="fas fa-thumbs-up"></i>
                                        </a>
                                        <a href="{{ path('demande_pdf_valideur', {id: demande.id}) }}">
                                            <i class="fas fa-file-pdf"></i>
                                        </a>
                                        <a href="{{ path('refuser_demande', {id: demande.id}) }}" onclick="return checkComment('{{ demande.id }}')">
                                            <i class="fas fa-thumbs-down"></i>
                                        </a>
                                    {% else %}
                                        <a href="{{ path('visualiser_demande', {id: demande.id}) }}">
                                            <i class="fas fa-search"></i>
                                        </a>
                                        <a href="{{ path('demande_pdf_valideur', {id: demande.id}) }}">
                                            <i class="fas fa-file-pdf"></i>
                                        </a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const filterSelect = document.getElementById('filter-select');
    const rows = document.querySelectorAll('tbody tr');

    filterSelect.addEventListener('change', function() {
        const filterValue = filterSelect.value;
        rows.forEach(row => {
            const status = row.getAttribute('data-status');
            if (filterValue === 'all' || (filterValue === 'Suivi dans LEKA' && status === 'Suivi dans LEKA') || (filterValue === 'En attente' && status === 'En attente') || (filterValue === 'Refusée' && status === 'Refusée')) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });

    // Disparition des alertes après 5 secondes
    setTimeout(function() {
        let alerts = document.querySelectorAll('.alert');
        alerts.forEach(function(alert) {
            alert.classList.add('fade');
        });
    }, 5000); // Disparition après 5 secondes
});

function checkComment(demandeId) {
    const commentaire = document.getElementById('commentaire-' + demandeId).value.trim();
    if (commentaire === '') {
        alert('Veuillez ajouter un commentaire avant de refuser la demande.');
        return false;
    }
    return true;
}

</script>
{% endblock %}
